<Window x:Class="DrawingRegister.App.ReportFilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrawingRegister.App"
        mc:Ignorable="d"
        Title="Generate PDF Report" Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    <Window.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        
        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style x:Key="RadioButtonStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#eb1845"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              Margin="15,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#d01641"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#b0133a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Generate PDF Report" Style="{StaticResource HeaderTextStyle}"/>
        
        <!-- Report Type Selection -->
        <GroupBox Grid.Row="1" Header="Report Type" Margin="0,10,0,10" Padding="10">
            <StackPanel>
                <RadioButton x:Name="AllDocumentsRadio" 
                             Content="All Documents" 
                             Style="{StaticResource RadioButtonStyle}"
                             Checked="ReportType_Changed"/>
                <RadioButton x:Name="FilteredDocumentsRadio" 
                             Content="Filtered by Purpose of Issue" 
                             Style="{StaticResource RadioButtonStyle}"
                             Checked="ReportType_Changed"/>
                <RadioButton x:Name="TransmittalRadio" 
                             Content="Transmittal (by Date)" 
                             Style="{StaticResource RadioButtonStyle}"
                             Checked="ReportType_Changed"/>
            </StackPanel>
        </GroupBox>
        
        <!-- Purpose Filter (shown when Filtered Documents is selected) -->
        <StackPanel Grid.Row="2" x:Name="PurposeFilterPanel" Visibility="Collapsed" Margin="0,10,0,10">
            <TextBlock Text="Select Purpose of Issue:" Style="{StaticResource LabelTextStyle}"/>
            <ComboBox x:Name="PurposeComboBox" Style="{StaticResource ComboBoxStyle}">
                <ComboBoxItem Content="All Purposes" IsSelected="True"/>
                <ComboBoxItem Content="Construction"/>
                <ComboBoxItem Content="Tender"/>
                <ComboBoxItem Content="Planning"/>
                <ComboBoxItem Content="Information"/>
                <ComboBoxItem Content="Draft"/>
                <ComboBoxItem Content="DSC"/>
                <ComboBoxItem Content="Warrant"/>
                <ComboBoxItem Content="Review"/>
                <ComboBoxItem Content="Setting Out"/>
                <ComboBoxItem Content="Structures"/>
                <ComboBoxItem Content="Approval"/>
                <ComboBoxItem Content="Feasibility"/>
            </ComboBox>
        </StackPanel>
        
        <!-- Date Filter (shown when Transmittal is selected) -->
        <StackPanel Grid.Row="3" x:Name="DateFilterPanel" Visibility="Collapsed" Margin="0,10,0,10">
            <TextBlock Text="Select Issue Date:" Style="{StaticResource LabelTextStyle}"/>
            <ComboBox x:Name="DateComboBox" Style="{StaticResource ComboBoxStyle}"/>
        </StackPanel>
        
        <!-- Additional Options -->
        <GroupBox Grid.Row="4" Header="Additional Options" Margin="0,10,0,10" Padding="10">
            <StackPanel>
                <CheckBox x:Name="IncludeDistributionCheckBox" 
                          Content="Include Distribution Information" 
                          FontSize="14" 
                          Margin="0,5"/>
                <CheckBox x:Name="GroupByPackageCheckBox" 
                          Content="Group by Package" 
                          FontSize="14" 
                          Margin="0,5"
                          IsChecked="True"/>
            </StackPanel>
        </GroupBox>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Generate Report" 
                    Style="{StaticResource ButtonStyle}" 
                    Width="130" 
                    Margin="0,0,10,0"
                    Click="GenerateReport_Click"/>
            <Button Content="Cancel" 
                    Style="{StaticResource ButtonStyle}" 
                    Background="#5a6268"
                    Width="100"
                    Click="Cancel_Click">
                <Button.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                To="#4a5258" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                To="#5a6268" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Button.Triggers>
            </Button>
        </StackPanel>
    </Grid>
</Window>