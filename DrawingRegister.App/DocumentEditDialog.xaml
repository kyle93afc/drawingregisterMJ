<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DrawingRegister.App.DocumentEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrawingRegister.App"
        mc:Ignorable="d"
        Title="Edit Document" Height="400" Width="500" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Document Number -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Document Number:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="Bold"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="DocumentNumberBox" Margin="0,0,0,10" Height="30" FontSize="14"/>

        <!-- Description -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Description:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="Bold"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="DescriptionBox" Margin="0,0,0,10" Height="30" FontSize="14"/>

        <!-- Package -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Package:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="Bold"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="PackageBox" Margin="0,0,0,10" Height="30" FontSize="14"/>

        <!-- Document Type -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Document Type:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="Bold"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="DocumentTypeBox" Margin="0,0,0,10" Height="30" FontSize="14"/>

        <!-- Size -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Size:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="Bold"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="SizeBox" Margin="0,0,0,10" Height="30" FontSize="14"/>

        <!-- Update File Option -->
        <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" x:Name="UpdateFileCheckbox" Content="Update source file name to match" IsChecked="True" Margin="0,10,0,10"/>

        <!-- Preview -->
        <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="#ddd" BorderThickness="1" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="File Name Preview:" Margin="5,5,5,0" FontWeight="Bold"/>
                <TextBlock x:Name="FileNamePreview" Margin="5" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Width="100" Height="35" Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="Save" Width="100" Height="35" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window> 