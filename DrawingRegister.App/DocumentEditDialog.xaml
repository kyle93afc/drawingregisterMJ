<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DrawingRegister.App.DocumentEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrawingRegister.App"
        mc:Ignorable="d"
        Title="Edit Document" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Slate50Brush}">
    <Grid Margin="16">
        <Border Style="{StaticResource CardStyle}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Dialog Title -->
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Edit Document" Style="{StaticResource HeadingMedium}" Margin="0,0,0,16"/>

                <!-- Document Number -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Document No" Style="{StaticResource SectionLabel}" Margin="0,0,12,10"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="DocumentNumberBox" Margin="0,0,0,10" Height="30"/>

                <!-- Description -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Description" Style="{StaticResource SectionLabel}" Margin="0,0,12,10"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="DescriptionBox" Margin="0,0,0,10" Height="30"/>

                <!-- Package -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Package" Style="{StaticResource SectionLabel}" Margin="0,0,12,10"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="PackageBox" Margin="0,0,0,10" Height="30"/>

                <!-- Document Type -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Type" Style="{StaticResource SectionLabel}" Margin="0,0,12,10"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="DocumentTypeBox" Margin="0,0,0,10" Height="30"/>

                <!-- Size -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Size" Style="{StaticResource SectionLabel}" Margin="0,0,12,10"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="SizeBox" Margin="0,0,0,10" Height="30"/>

                <!-- Update File Option -->
                <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" x:Name="UpdateFileCheckbox"
                          Content="Update source file name to match" IsChecked="True" Margin="0,8,0,8" FontSize="12"/>

                <!-- Preview -->
                <Border Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                        Background="{StaticResource Slate50Brush}" BorderBrush="{StaticResource Slate200Brush}"
                        BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="File Name Preview" FontWeight="SemiBold" FontSize="11"
                                   Foreground="{StaticResource Slate600Brush}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="FileNamePreview" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Buttons -->
                <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Cancel" Width="100" Height="32" Margin="0,0,8,0"
                            Click="CancelButton_Click" Style="{StaticResource GhostButton}"/>
                    <Button x:Name="SaveButton" Content="Save" Width="100" Height="32"
                            Click="SaveButton_Click" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
