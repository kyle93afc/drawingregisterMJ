<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DrawingRegister.App.RevisionEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Revision Details"
        Height="340" Width="420"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Slate50Brush}">
    <Grid Margin="16">
        <Border Style="{StaticResource CardStyle}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Document Info -->
                <TextBlock Grid.Row="0" Text="{Binding DocumentNumber}" Style="{StaticResource HeadingMedium}" Margin="0,0,0,12"/>

                <!-- Date -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="Date of Issue" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding IssueDate, StringFormat=dd/MM/yyyy}" FontSize="13"/>
                </StackPanel>

                <!-- Purpose of Issue -->
                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="Purpose of Issue" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="PurposeCombo" SelectedValue="{Binding Purpose}" Height="28">
                        <ComboBoxItem Content="Concept Issue"/>
                        <ComboBoxItem Content="Planning Issue"/>
                        <ComboBoxItem Content="Warrant / Tender"/>
                        <ComboBoxItem Content="Construction Issue"/>
                        <ComboBoxItem Content="Approval"/>
                        <ComboBoxItem Content="Construction"/>
                        <ComboBoxItem Content="Draft"/>
                        <ComboBoxItem Content="Feasibility"/>
                        <ComboBoxItem Content="Information"/>
                        <ComboBoxItem Content="Planning"/>
                        <ComboBoxItem Content="Tender"/>
                        <ComboBoxItem Content="Warrant"/>
                    </ComboBox>
                </StackPanel>

                <!-- Revision -->
                <StackPanel Grid.Row="3" Margin="0,0,0,10">
                    <TextBlock Text="Revision" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Revision}" FontSize="15" FontWeight="Bold"/>
                </StackPanel>

                <!-- Method of Issue -->
                <StackPanel Grid.Row="4" Margin="0,0,0,10">
                    <TextBlock Text="Method of Issue" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="MethodCombo" SelectedValue="{Binding Method}" Height="28">
                        <ComboBoxItem Content="Email"/>
                        <ComboBoxItem Content="Sharepoint"/>
                    </ComboBox>
                </StackPanel>

                <!-- Issued By -->
                <StackPanel Grid.Row="5" Margin="0,0,0,10">
                    <TextBlock Text="Issued By" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="IssuedByBox" Text="{Binding IssuedBy}"
                             MaxLength="2" CharacterCasing="Upper" Height="28" Width="60" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="CancelButton_Click"
                            Style="{StaticResource GhostButton}" Height="32"/>
                    <Button Content="Save" Width="80" Click="SaveButton_Click"
                            Style="{StaticResource PrimaryButton}" Height="32"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
