<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DrawingRegister.App.RevisionEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Revision Details" 
        Style="{StaticResource RevisionEditDialog}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Document Info -->
        <TextBlock Grid.Row="0" Text="{Binding DocumentNumber}" FontWeight="Bold" Margin="0,0,0,10"/>
        
        <!-- Date -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="DATE OF ISSUE:" FontWeight="Bold"/>
            <TextBlock Text="{Binding IssueDate, StringFormat=dd/MM/yyyy}"/>
        </StackPanel>

        <!-- Purpose of Issue -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="PURPOSE OF ISSUE:" FontWeight="Bold"/>
            <ComboBox x:Name="PurposeCombo" SelectedValue="{Binding Purpose}" Margin="0,5,0,0">
                <ComboBoxItem Content="Approval"/>
                <ComboBoxItem Content="Construction"/>
                <ComboBoxItem Content="Draft"/>
                <ComboBoxItem Content="Feasibility"/>
                <ComboBoxItem Content="Information"/>
                <ComboBoxItem Content="Planning"/>
                <ComboBoxItem Content="Tender"/>
                <ComboBoxItem Content="Warrant"/>
            </ComboBox>
        </StackPanel>

        <!-- Revision -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="REVISION:" FontWeight="Bold"/>
            <TextBlock Text="{Binding Revision}" FontSize="16" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Method of Issue -->
        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Text="METHOD OF ISSUE:" FontWeight="Bold"/>
            <ComboBox x:Name="MethodCombo" SelectedValue="{Binding Method}" Margin="0,5,0,0">
                <ComboBoxItem Content="Email"/>
                <ComboBoxItem Content="Sharepoint"/>
            </ComboBox>
        </StackPanel>

        <!-- Issued By -->
        <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <TextBlock Text="ISSUED BY:" FontWeight="Bold"/>
            <TextBox x:Name="IssuedByBox" Text="{Binding IssuedBy}" 
                     MaxLength="2" CharacterCasing="Upper" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Width="80" Margin="0,0,10,0" Click="SaveButton_Click"/>
            <Button Content="Cancel" Width="80" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window> 