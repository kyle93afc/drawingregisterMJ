<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DrawingRegister.App.RevisionEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Revision Details"
        Height="340" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="White" WindowStyle="None" AllowsTransparency="True">
    <Border BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="10" Background="White"
            Effect="{StaticResource ElevatedShadow}" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="20,14,14,10" MouseLeftButtonDown="Header_DragMove">
                <StackPanel>
                    <TextBlock Text="{Binding DocumentNumber}" Style="{StaticResource HeadingMedium}"/>
                    <TextBlock Text="Edit revision details" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="CancelButton_Click" Style="{StaticResource ToolbarButton}" FontSize="14" Width="28" Height="28" Padding="0"/>
            </Grid>

            <!-- Accent Line -->
            <Border Grid.Row="1" Background="{StaticResource BrandRedBrush}" Height="3"/>

            <!-- Content -->
            <StackPanel Grid.Row="2" Margin="20,16,20,8">
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Date of Issue" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding IssueDate, StringFormat=dd/MM/yyyy}" FontSize="13"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Purpose of Issue" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="PurposeCombo" SelectedValue="{Binding Purpose}" Height="28">
                        <ComboBoxItem Content="Concept Issue"/>
                        <ComboBoxItem Content="Planning Issue"/>
                        <ComboBoxItem Content="Warrant / Tender"/>
                        <ComboBoxItem Content="Construction Issue"/>
                        <ComboBoxItem Content="Approval"/>
                        <ComboBoxItem Content="Construction"/>
                        <ComboBoxItem Content="Draft"/>
                        <ComboBoxItem Content="Feasibility"/>
                        <ComboBoxItem Content="Information"/>
                        <ComboBoxItem Content="Planning"/>
                        <ComboBoxItem Content="Tender"/>
                        <ComboBoxItem Content="Warrant"/>
                    </ComboBox>
                </StackPanel>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Revision" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Revision}" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Issued By" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                        <TextBox x:Name="IssuedByBox" Text="{Binding IssuedBy}"
                                 MaxLength="2" CharacterCasing="Upper" Height="28" Width="60" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="Method of Issue" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="MethodCombo" SelectedValue="{Binding Method}" Height="28">
                        <ComboBoxItem Content="Email"/>
                        <ComboBoxItem Content="Sharepoint"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="3" Background="{StaticResource Slate50Brush}" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,1,0,0" Padding="20,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="CancelButton_Click"
                            Style="{StaticResource GhostButton}" Height="30"/>
                    <Button Content="Save" Width="80" Click="SaveButton_Click"
                            Style="{StaticResource PrimaryButton}" Height="30"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
