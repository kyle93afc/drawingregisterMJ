<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DrawingRegister.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrawingRegister.App"
        xmlns:converters="clr-namespace:DrawingRegister.App.Converters"
        mc:Ignorable="d"
        Title="SER DOCUMENT AND DRAWING REGISTER" Height="800" Width="1200">
    <Window.Resources>
        <converters:DateToColumnConverter x:Key="DateToColumnConverter"/>
        <converters:LatestRevisionConverter x:Key="LatestRevisionConverter"/>
        <converters:RevisionColorConverter x:Key="RevisionColorConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#5a6268"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4a5258"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#3d444a"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#6c757d"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5a6268"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#545b62"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Styles -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#eb1845"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#ddd"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#f2f2f2"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ddd"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Revision Cell Template -->
        <DataTemplate x:Key="RevisionCellTemplate">
            <Border BorderBrush="#ddd" BorderThickness="1" Width="120" Background="White">
                <TextBlock Text="{Binding}" Padding="8" TextWrapping="Wrap"/>
            </Border>
        </DataTemplate>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header Info -->
            <RowDefinition Height="Auto"/>  <!-- Distribution Header -->
            <RowDefinition Height="Auto"/>  <!-- Action Buttons -->
            <RowDefinition Height="Auto"/>  <!-- Search Panel -->
            <RowDefinition Height="Auto"/>  <!-- Date Filter -->
            <RowDefinition Height="*"/>     <!-- Documents Grid -->
            <RowDefinition Height="Auto"/>  <!-- Revision Timeline -->
        </Grid.RowDefinitions>

        <!-- Header Info -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 1 -->
            <TextBlock Text="DISCIPLINE:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <TextBox x:Name="DisciplineBox" Grid.Row="0" Grid.Column="1" Margin="0,0,20,5"/>
            <TextBlock Text="REG NO:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <TextBox x:Name="RegNoBox" Grid.Row="0" Grid.Column="3" Width="300" Margin="0,0,0,5"/>

            <!-- Row 2 -->
            <TextBlock Text="PROJECT NO:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <TextBox x:Name="ProjectNoBox" Grid.Row="1" Grid.Column="1" Margin="0,0,20,5"/>
            <TextBlock Text="CLIENT NO:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <TextBox x:Name="ClientNoBox" Grid.Row="1" Grid.Column="3" Margin="0,0,0,5"/>

            <!-- Row 3 -->
            <TextBlock Text="PROJECT NAME:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <TextBox x:Name="ProjectNameBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,5"/>
        </Grid>

        <!-- Distribution Header -->
        <TextBlock Grid.Row="1" Text="DISTRIBUTION" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Scan Outgoing PDF Folder" Click="ImportDocuments_Click"/>
            <Button Content="Save Project" Click="SaveProject_Click"/>
            <Button Content="Refresh View" Click="RefreshView_Click"/>
        </StackPanel>

        <!-- Search Panel -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="SEARCH:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="SearchBox" Width="200" Margin="0,0,10,0" TextChanged="SearchBox_TextChanged"/>
            <ComboBox x:Name="SearchTypeCombo" Width="120" Margin="0,0,10,0" SelectedIndex="0">
                <ComboBoxItem Content="Document No"/>
                <ComboBoxItem Content="Description"/>
                <ComboBoxItem Content="Package"/>
                <ComboBoxItem Content="Type"/>
            </ComboBox>
        </StackPanel>

        <!-- Move Date Filters to New Row -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="FILTER BY DATE:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <DatePicker x:Name="StartDatePicker" Width="120" Margin="0,0,10,0"/>
            <DatePicker x:Name="EndDatePicker" Width="120" Margin="0,0,10,0"/>
            <Button Content="Apply Filter" Click="DateFilter_Click"/>
            <Button Content="Clear Filter" Click="ClearDateFilter_Click" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>

        <!-- Documents Grid -->
        <DataGrid x:Name="DocumentGrid" 
                  Grid.Row="5" 
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="DocumentGrid_SelectionChanged"
                  AlternationCount="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  BorderThickness="1"
                  BorderBrush="#ddd">
            <DataGrid.Columns>
                <DataGridTextColumn Header="DOCUMENT NO" Binding="{Binding DocumentNumber}" Width="200"/>
                <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="PACKAGE" Binding="{Binding Package}" Width="100"/>
                <DataGridTextColumn Header="TYPE" Binding="{Binding DocumentType}" Width="100"/>
                <DataGridTextColumn Header="SIZE" Binding="{Binding Size}" Width="80"/>
                <DataGridTextColumn Header="LATEST REV" 
                                  Binding="{Binding RevisionHistory, Converter={StaticResource LatestRevisionConverter}}"
                                  Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Revision Timeline -->
        <ScrollViewer Grid.Row="6" 
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,10,0,0">
            <ItemsControl x:Name="RevisionTimeline" 
                          ItemsSource="{Binding SelectedDocument.RevisionHistory}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#eb1845" BorderThickness="1" 
                                Margin="4" Padding="0" 
                                Background="{Binding Value.Purpose, Converter={StaticResource RevisionColorConverter}}"
                                MouseLeftButtonDown="RevisionTimeline_MouseDoubleClick">
                            <StackPanel>
                                <TextBlock Text="{Binding Key, StringFormat=yyyy-MM-dd}" 
                                           Background="#eb1845" Foreground="White"
                                           Padding="4" FontWeight="Bold" TextAlignment="Center"/>
                                
                                <StackPanel Margin="8">
                                    <TextBlock Text="{Binding Value.Revision}" FontSize="16" 
                                               FontWeight="Bold" HorizontalAlignment="Center"/>
                                    
                                    <TextBlock Text="{Binding Value.Purpose}" Margin="0,5" 
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                    
                                    <TextBlock Text="{Binding Value.Method}" FontStyle="Italic"
                                               HorizontalAlignment="Center"/>
                                    
                                    <TextBlock Text="{Binding Value.IssuedBy}" Margin="0,5"
                                               Foreground="#444" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
