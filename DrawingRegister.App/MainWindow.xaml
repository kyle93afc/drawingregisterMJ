<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DrawingRegister.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrawingRegister.App"
        xmlns:converters="clr-namespace:DrawingRegister.App.Converters"
        mc:Ignorable="d"
        Title="Drawing Register" Height="800" Width="1200">
    <Window.Resources>
        <converters:DateToColumnConverter x:Key="DateToColumnConverter"/>
        <converters:LatestRevisionConverter x:Key="LatestRevisionConverter"/>
        
        <!-- Styles -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- Revision Cell Template -->
        <DataTemplate x:Key="RevisionCellTemplate">
            <Border BorderBrush="Gray" BorderThickness="1" Width="120" Background="White">
                <TextBlock Text="{Binding}" Padding="5" TextWrapping="Wrap"/>
            </Border>
        </DataTemplate>

        <!-- Header Template -->
        <DataTemplate x:Key="HeaderTemplate">
            <Border BorderBrush="Gray" BorderThickness="1" Width="120" Background="LightGray">
                <TextBlock Text="{Binding}" Padding="5" FontWeight="Bold"/>
            </Border>
        </DataTemplate>

        <!-- ItemsPanel Template for Horizontal Layout -->
        <ItemsPanelTemplate x:Key="HorizontalItemsPanel">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Project Info -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Label Content="Project No:" VerticalAlignment="Center"/>
            <TextBox x:Name="ProjectNoBox" Width="100" Margin="5,0"/>
            
            <Label Content="Project Name:" VerticalAlignment="Center"/>
            <TextBox x:Name="ProjectNameBox" Width="200" Margin="5,0"/>
            
            <Label Content="Discipline:" VerticalAlignment="Center"/>
            <TextBox x:Name="DisciplineBox" Width="100" Margin="5,0"/>
            
            <Label Content="Register No:" VerticalAlignment="Center"/>
            <TextBox x:Name="RegNoBox" Width="100" Margin="5,0"/>
            
            <Label Content="Client No:" VerticalAlignment="Center"/>
            <TextBox x:Name="ClientNoBox" Width="100" Margin="5,0"/>
            
            <Button Content="Import Documents" Click="ImportDocuments_Click" Margin="20,0,5,0" Padding="10,5"/>
            <Button Content="Refresh View" Click="RefreshView_Click" Margin="5,0" Padding="10,5"/>
        </StackPanel>

        <!-- Search Box -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,10">
            <Label Content="Search:" VerticalAlignment="Center"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Width="300" Margin="5,0"/>
        </StackPanel>

        <!-- Documents Grid -->
        <DataGrid x:Name="DocumentGrid" Grid.Row="2" Margin="10"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="DocumentGrid_SelectionChanged"
                  AlternatingRowBackground="#FFF8F8F8"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Document No" Binding="{Binding DocumentNumber}" Width="200"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Package" Binding="{Binding Package}" Width="80"/>
                <DataGridTextColumn Header="Type" Binding="{Binding DocumentType}" Width="80"/>
                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="60"/>
                <DataGridTextColumn Header="Latest Rev" 
                                  Binding="{Binding RevisionHistory, Converter={StaticResource LatestRevisionConverter}}"
                                  Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Revision History -->
        <ScrollViewer Grid.Row="3" 
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Disabled"
                      MaxHeight="150" 
                      Margin="10"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
            <ItemsControl x:Name="RevisionHistoryControl"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding}"
                                    ItemTemplate="{StaticResource RevisionCellTemplate}"
                                    ItemsPanel="{StaticResource HorizontalItemsPanel}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
