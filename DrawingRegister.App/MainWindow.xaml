<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DrawingRegister.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrawingRegister.App"
        xmlns:converters="clr-namespace:DrawingRegister.App.Converters"
        mc:Ignorable="d"
        Title="DOCUMENT AND DRAWING REGISTER" Height="800" Width="1200">
    <Window.Resources>
        <converters:DateToColumnConverter x:Key="DateToColumnConverter"/>
        <converters:LatestRevisionConverter x:Key="LatestRevisionConverter"/>
        <converters:RevisionColorConverter x:Key="RevisionColorConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:LatestRevisionDateConverter x:Key="LatestRevisionDateConverter"/>
        <converters:RevisionAtDateConverter x:Key="RevisionAtDateConverter"/>
        
        <!-- Style to hide column headers -->
        <Style x:Key="HiddenHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- Style for visible headers -->
        <Style x:Key="VisibleHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#eb1845"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#ddd"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        
        <!-- Global Effects -->
        <DropShadowEffect x:Key="MaterialDropShadow" 
                         BlurRadius="4" 
                         Direction="270" 
                         ShadowDepth="2" 
                         Opacity="0.2" 
                         Color="#000000"/>
        
        <!-- Button Style -->
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#5a6268"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Effect="{StaticResource MaterialDropShadow}">
                            <ContentPresenter x:Name="contentPresenter" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            TextBlock.FontWeight="SemiBold"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border"
                                                      Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                      To="#4a5258" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border"
                                                      Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                      To="#5a6268" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3d444a"/>
                                <Setter TargetName="contentPresenter" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDBDBD"/>
                                <Setter Property="Foreground" Value="#757575"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}"/>
        
        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#6c757d"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                          To="#5a6268" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                          To="#6c757d" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#545b62"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Styles -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#eb1845"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#ddd"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="RotatedColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <StackPanel>
                                    <TextBlock Text="{TemplateBinding Content}">
                                        <TextBlock.LayoutTransform>
                                            <RotateTransform Angle="-90"/>
                                        </TextBlock.LayoutTransform>
                                        <TextBlock.Margin>2,25,2,5</TextBlock.Margin>
                                        <TextBlock.TextAlignment>Left</TextBlock.TextAlignment>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#f2f2f2"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ddd"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Revision Cell Template -->
        <DataTemplate x:Key="RevisionCellTemplate">
            <Border BorderBrush="#ddd" BorderThickness="1" Width="120" Background="White">
                <TextBlock Text="{Binding}" Padding="8" TextWrapping="Wrap"/>
            </Border>
        </DataTemplate>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Add Revision Edit Dialog -->
        <Style x:Key="RevisionEditDialog" TargetType="Window">
            <Setter Property="Height" Value="300"/>
            <Setter Property="Width" Value="400"/>
            <Setter Property="WindowStyle" Value="ToolWindow"/>
            <Setter Property="ResizeMode" Value="NoResize"/>
        </Style>

        <!-- Add global style at top -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header Info -->
            <RowDefinition Height="Auto"/>  <!-- Action Buttons -->
            <RowDefinition Height="Auto"/>  <!-- Search Panel -->
            <RowDefinition Height="Auto"/>  <!-- Date Filter -->
            <RowDefinition Height="Auto"/>  <!-- Issue Information Section -->
            <RowDefinition Height="*"/>     <!-- Documents Grid -->
            <RowDefinition Height="Auto"/>  <!-- Revision Timeline -->
        </Grid.RowDefinitions>

        <!-- Header Info -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo -->
            <Image Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                   Source="/Resources/company-logo.png" 
                   Height="50" 
                   HorizontalAlignment="Left" 
                   Margin="0,0,0,10"/>

            <!-- Row 1 -->
            <TextBlock Text="DISCIPLINE:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,5" FontSize="14"/>
            <TextBox x:Name="DisciplineBox" Grid.Row="1" Grid.Column="1" Margin="0,0,20,5" FontSize="14"/>
            <TextBlock Text="REG NO:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,5" FontSize="14"/>
            <TextBox x:Name="RegNoBox" Grid.Row="1" Grid.Column="3" Width="300" Margin="0,0,0,5" FontSize="14"/>

            <!-- Row 2 -->
            <TextBlock Text="PROJECT NO:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,5" FontSize="14"/>
            <TextBox x:Name="ProjectNoBox" Grid.Row="2" Grid.Column="1" Margin="0,0,20,5" FontSize="14"/>
            <TextBlock Text="CLIENT NO:" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,5" FontSize="14"/>
            <TextBox x:Name="ClientNoBox" Grid.Row="2" Grid.Column="3" Margin="0,0,0,5" FontSize="14"/>

            <!-- Row 3 -->
            <TextBlock Text="PROJECT NAME:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,5" FontSize="14"/>
            <TextBox x:Name="ProjectNameBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,5" FontSize="14"/>
        </Grid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,5">
            <Button Content="SCAN OUTGOING PDF FOLDER" Click="ImportDocuments_Click" Style="{StaticResource BaseButtonStyle}" Height="35" Margin="0,0,5,0" FontSize="14"/>
            <Button Content="SAVE PROJECT" Click="SaveProject_Click" Style="{StaticResource BaseButtonStyle}" Height="35" Margin="0,0,5,0" FontSize="14"/>
            <Button Content="REFRESH VIEW" Click="RefreshView_Click" Style="{StaticResource BaseButtonStyle}" Height="35" Margin="0,0,5,0" FontSize="14"/>
            <Button Content="MANAGE DISTRIBUTION" Click="ManageDistribution_Click" Style="{StaticResource BaseButtonStyle}" Height="35" Margin="0,0,5,0" FontSize="14"/>
            <Button Content="BATCH EDIT" Click="BatchEdit_Click" Style="{StaticResource BaseButtonStyle}" Height="35" Margin="0,0,5,0" FontSize="14"/>
            <Button Content="GENERATE PDF REPORT" Click="GeneratePdfReport_Click" Style="{StaticResource BaseButtonStyle}" Height="35" Margin="0,0,5,0" FontSize="14"/>
            <!-- ADDED BUTTON FOR REMOVING DOCUMENT ENTRY -->
            <Button x:Name="RemoveDocumentButton" Content="Remove Selected Document Entry" Click="RemoveDocumentButton_Click" Style="{StaticResource BaseButtonStyle}" Height="35" Margin="0,0,5,0" FontSize="14"/>
        </StackPanel>

        <!-- Search Panel -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="SEARCH:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
            <TextBox x:Name="SearchBox" Width="200" TextChanged="SearchBox_TextChanged" Height="35" Margin="0,0,10,0" FontSize="14"/>
            <ComboBox x:Name="SearchTypeCombo" Width="120" Height="35" FontSize="14" SelectionChanged="SearchTypeCombo_SelectionChanged">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Setter Property="FontSize" Value="14"/>
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBoxItem Content="Document No"/>
                <ComboBoxItem Content="Description"/>
                <ComboBoxItem Content="Package"/>
                <ComboBoxItem Content="Type"/>
            </ComboBox>
        </StackPanel>

        <!-- Date Filter -->
        <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="FILTER BY DATE:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
                <DatePicker x:Name="StartDatePicker" Width="200" Height="35" Margin="0,0,10,0" FontSize="14"/>
                <DatePicker x:Name="EndDatePicker" Width="200" Height="35" Margin="0,0,10,0" FontSize="14"/>
                <Button Content="APPLY FILTER" Click="DateFilter_Click" Height="35" Margin="0,0,5,0" FontSize="14"/>
                <Button Content="CLEAR FILTER" Click="ClearDateFilter_Click" Style="{StaticResource BaseButtonStyle}" Height="35" FontSize="14"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="FILTER BY DATE OF ISSUE:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
                <ComboBox x:Name="IssueDateFilter" Width="200" Height="35" Margin="0,0,10,0" FontSize="14" SelectionChanged="IssueDateFilter_SelectionChanged">
                    <ComboBoxItem Content="All Dates" FontSize="14"/>
                </ComboBox>
                
                <!-- New Distribution Button -->
                <Button x:Name="ViewDistributionButton" Content="VIEW DISTRIBUTION" Click="ViewDistribution_Click" 
                        Height="35" Margin="0,0,10,0" FontSize="14" FontWeight="Bold"
                        Background="#eb1845" Foreground="White" Visibility="Visible"/>
                
                <!-- Distribution Summary -->
                <Border x:Name="DistributionSummaryBorder" BorderBrush="#ddd" BorderThickness="1" CornerRadius="4" Padding="10,5" 
                        Margin="0,0,20,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="DISTRIBUTION: " FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock x:Name="DistributionSummaryText" Text="No recipients" FontSize="14"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="PURPOSE OF ISSUE:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
                <ComboBox x:Name="PurposeOfIssueFilter" Width="120" Height="35" Margin="0,0,10,0" FontSize="14" SelectionChanged="PurposeOfIssueFilter_SelectionChanged">
                    <ComboBoxItem Content="All" FontSize="14"/>
                    <ComboBoxItem Content="A - Approval" FontSize="14"/>
                    <ComboBoxItem Content="C - Construction" FontSize="14"/>
                    <ComboBoxItem Content="I - Information" FontSize="14"/>
                    <ComboBoxItem Content="T - Tender" FontSize="14"/>
                    <ComboBoxItem Content="W - Warrant" FontSize="14"/>
                    <ComboBoxItem Content="P - Planning" FontSize="14"/>
                </ComboBox>
                
                <!-- Purpose Indicators -->
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                    <Border x:Name="PurposeA" Width="20" Height="20" Background="Transparent" BorderBrush="Gray" BorderThickness="1" Margin="2,0">
                        <TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
                    </Border>
                    <Border x:Name="PurposeC" Width="20" Height="20" Background="Transparent" BorderBrush="Gray" BorderThickness="1" Margin="2,0">
                        <TextBlock Text="C" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
                    </Border>
                    <Border x:Name="PurposeI" Width="20" Height="20" Background="Transparent" BorderBrush="Gray" BorderThickness="1" Margin="2,0">
                        <TextBlock Text="I" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
                    </Border>
                    <Border x:Name="PurposeT" Width="20" Height="20" Background="Transparent" BorderBrush="Gray" BorderThickness="1" Margin="2,0">
                        <TextBlock Text="T" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
                    </Border>
                    <Border x:Name="PurposeW" Width="20" Height="20" Background="Transparent" BorderBrush="Gray" BorderThickness="1" Margin="2,0">
                        <TextBlock Text="W" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
                    </Border>
                    <Border x:Name="PurposeP" Width="20" Height="20" Background="Transparent" BorderBrush="Gray" BorderThickness="1" Margin="2,0">
                        <TextBlock Text="P" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
                    </Border>
                </StackPanel>

                <TextBlock Text="METHOD OF ISSUE:" VerticalAlignment="Center" Margin="20,0,10,0" FontSize="14"/>
                <ComboBox x:Name="MethodOfIssueFilter" Width="120" Height="35" Margin="0,0,10,0" FontSize="14" SelectionChanged="MethodOfIssueFilter_SelectionChanged">
                    <ComboBoxItem Content="All" FontSize="14"/>
                    <ComboBoxItem Content="E - Email" FontSize="14"/>
                    <ComboBoxItem Content="S - SharePoint" FontSize="14"/>
                    <ComboBoxItem Content="P - Post" FontSize="14"/>
                    <ComboBoxItem Content="H - Hand" FontSize="14"/>
                </ComboBox>
                
                <!-- Method Indicators -->
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                    <Border x:Name="MethodE" Width="20" Height="20" Background="Transparent" BorderBrush="Gray" BorderThickness="1" Margin="2,0">
                        <TextBlock Text="E" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
                    </Border>
                    <Border x:Name="MethodS" Width="20" Height="20" Background="Transparent" BorderBrush="Gray" BorderThickness="1" Margin="2,0">
                        <TextBlock Text="S" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
                    </Border>
                    <Border x:Name="MethodP" Width="20" Height="20" Background="Transparent" BorderBrush="Gray" BorderThickness="1" Margin="2,0">
                        <TextBlock Text="P" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
                    </Border>
                    <Border x:Name="MethodH" Width="20" Height="20" Background="Transparent" BorderBrush="Gray" BorderThickness="1" Margin="2,0">
                        <TextBlock Text="H" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
                    </Border>
                </StackPanel>

                <TextBlock Text="ISSUED BY:" VerticalAlignment="Center" Margin="20,0,10,0" FontSize="14"/>
                <TextBox x:Name="IssuedByFilter" Width="60" Height="35" Margin="0,0,10,0" MaxLength="2" CharacterCasing="Upper" FontSize="14" TextChanged="IssuedByFilter_TextChanged"/>

                <Button Content="SAVE ISSUE DETAILS" Click="SaveIssueDetails_Click" Height="35" FontSize="14"
                        Style="{StaticResource BaseButtonStyle}"/>
            </StackPanel>
        </StackPanel>

        <!-- Issue Information Section -->
        <Border Grid.Row="4" BorderBrush="Black" BorderThickness="1" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Distribution Information Row -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="DISTRIBUTION:" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,5,10,5" FontWeight="Bold"/>
                    <TextBlock x:Name="DistributionInfoText" Grid.Column="1" Text="No recipients selected" 
                               HorizontalAlignment="Left" VerticalAlignment="Center" 
                               Margin="0,5,10,5" TextWrapping="Wrap"/>
                </Grid>
                
                <!-- Method Indicators Row -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Purpose of Issue -->
                    <TextBlock Grid.Column="0" Text="PURPOSE OF ISSUE" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,5,10,5" FontWeight="Bold"/>
                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Width="25" Height="25" Margin="0,5,10,5">
                        <TextBlock x:Name="CurrentPurposeIndicator" Text="" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                    
                    <!-- Method of Issue -->
                    <TextBlock Grid.Column="2" Text="METHOD OF ISSUE" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,5,10,5" FontWeight="Bold"/>
                    <Border Grid.Column="3" BorderBrush="Black" BorderThickness="1" Width="25" Height="25" Margin="0,5,10,5">
                        <TextBlock x:Name="CurrentMethodIndicator" Text="" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                    
                    <!-- Issued By -->
                    <TextBlock Grid.Column="4" Text="ISSUED BY" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,5,10,5" FontWeight="Bold"/>
                    <Border Grid.Column="5" BorderBrush="Black" BorderThickness="1" Width="25" Height="25" Margin="0,5,10,5">
                        <TextBlock x:Name="CurrentIssuedByIndicator" Text="" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                </Grid>
                
                <!-- Date Row -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="DATE OF ISSUE" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,5,10,5" FontWeight="Bold"/>
                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Width="100" Height="25" Margin="0,5,10,5">
                        <TextBlock x:Name="CurrentIssueDate" Text="{Binding ElementName=IssueDateFilter, Path=SelectedItem.Content}" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Documents Grid -->
        <DataGrid x:Name="DocumentGrid" 
                  Grid.Row="5" 
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="DocumentGrid_SelectionChanged"
                  AlternationCount="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  ColumnWidth="Auto"
                  BorderThickness="1"
                  BorderBrush="#ddd"
                  FontSize="14">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Edit Document" Click="EditDocument_Click"/>
                    <MenuItem Header="Manage Distribution" Click="ManageDistribution_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="DOCUMENT NO" 
                                  Binding="{Binding DocumentNumber}" 
                                  Width="Auto"
                                  FontSize="14"/>
                <DataGridTextColumn Header="DESCRIPTION" 
                                  Binding="{Binding Description}" 
                                  Width="Auto"
                                  FontSize="14"/>
                <DataGridTextColumn Header="PACKAGE" 
                                  Binding="{Binding Package}" 
                                  Width="Auto"
                                  FontSize="14"/>
                <DataGridTextColumn Header="TYPE" 
                                  Binding="{Binding DocumentType}" 
                                  Width="Auto"
                                  FontSize="14"/>
                <DataGridTextColumn Header="SIZE" 
                                  Binding="{Binding Size}" 
                                  Width="Auto"
                                  FontSize="14"/>
                <DataGridTextColumn Header="LATEST REV" 
                                  Binding="{Binding RevisionHistory, Converter={StaticResource LatestRevisionConverter}}"
                                  Width="Auto"
                                  FontSize="14"/>
                <DataGridTextColumn Header="LAST DATE OF ISSUE" 
                                  Binding="{Binding RevisionHistory, Converter={StaticResource LatestRevisionDateConverter}}"
                                  Width="Auto"
                                  FontSize="14"/>
                <!-- Revision columns will be added dynamically -->
            </DataGrid.Columns>
        </DataGrid>

        <!-- Revision Timeline -->
        <ScrollViewer Grid.Row="6" 
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,10,0,0">
            <ItemsControl x:Name="RevisionTimeline" 
                          ItemsSource="{Binding SelectedDocument.RevisionHistory}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#eb1845" BorderThickness="1" 
                                Margin="4" Padding="0" 
                                Background="{Binding Value.Purpose, Converter={StaticResource RevisionColorConverter}}"
                                MouseLeftButtonDown="RevisionTimeline_MouseDoubleClick">
                            <StackPanel>
                                <TextBlock Text="{Binding Key, StringFormat=dd/MM/yyyy}" 
                                           Background="#eb1845" Foreground="White"
                                           Padding="4" FontWeight="Bold" TextAlignment="Center"/>
                                
                                <StackPanel Margin="8">
                                    <TextBlock Text="{Binding Value.Revision}" FontSize="16" 
                                               FontWeight="Bold" HorizontalAlignment="Center"/>
                                    
                                    <TextBlock Text="{Binding Value.Purpose}" Margin="0,5" 
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                    
                                    <TextBlock Text="{Binding Value.Method}" FontStyle="Italic"
                                               HorizontalAlignment="Center"/>
                                    
                                    <TextBlock Text="{Binding Value.IssuedBy}" Margin="0,5"
                                               Foreground="#444" HorizontalAlignment="Center"/>

                                    <Button Content="Edit" Margin="0,5,0,0" Padding="10,2"
                                            Click="EditRevision_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</Window>
