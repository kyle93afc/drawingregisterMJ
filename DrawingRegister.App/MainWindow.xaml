<Window x:Class="DrawingRegister.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrawingRegister.App"
        xmlns:converters="clr-namespace:DrawingRegister.App.Converters"
        mc:Ignorable="d"
        Title="SER DOCUMENT AND DRAWING REGISTER" Height="900" Width="1400"
        Background="White">
    <Window.Resources>
        <converters:DateToColumnConverter x:Key="DateToColumnConverter"/>
    </Window.Resources>
    <DockPanel>
        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- Logo -->
            <Image Grid.Row="0" Grid.Column="4" Grid.RowSpan="3" Source="logo.png" Height="60" HorizontalAlignment="Right"/>

            <!-- Project Info -->
            <TextBlock Text="Discipline:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="DisciplineBox" Grid.Row="0" Grid.Column="1" Margin="5" Text="Structural"/>

            <TextBlock Text="Reg No." Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="RegNoBox" Grid.Row="0" Grid.Column="3" Margin="5"/>

            <TextBlock Text="Project No." Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="ProjectNoBox" Grid.Row="1" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Client No." Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="ClientNoBox" Grid.Row="1" Grid.Column="3" Margin="5"/>

            <TextBlock Text="Project Name:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="ProjectNameBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="5"/>
        </Grid>

        <!-- Distribution Section -->
        <Grid DockPanel.Dock="Top" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="DISTRIBUTION" FontWeight="Bold" Margin="0,10,0,5"/>
            <DataGrid Grid.Row="1" x:Name="DistributionGrid" AutoGenerateColumns="False" Height="120" 
                      CanUserAddRows="True" CanUserDeleteRows="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Role" Width="100" Binding="{Binding Role}"/>
                    <DataGridTextColumn Header="Company" Width="200" Binding="{Binding Company}"/>
                    <DataGridTemplateColumn Header="Distribution" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Distributions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="*" Margin="2,0" FontWeight="Bold"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Issue Information -->
        <Grid DockPanel.Dock="Top" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Row="0">
                <TextBlock Text="Date of Issue" FontWeight="Bold" Width="120"/>
                <ItemsControl x:Name="IssueDatesControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat=dd/MM/yyyy}" Width="80" TextAlignment="Center"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Purpose of Issue:" Width="120"/>
                    <ItemsControl x:Name="PurposeControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Width="80" TextAlignment="Center"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Method of Issue:" Width="120"/>
                    <ItemsControl x:Name="MethodControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Width="80" TextAlignment="Center"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Issued By:" Width="120"/>
                    <ItemsControl x:Name="IssuedByControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Width="80" TextAlignment="Center"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <ToolBar DockPanel.Dock="Top" Background="#2196F3" Height="40">
            <Button Content="Import Documents" Margin="5" Padding="10,0" Click="ImportDocuments_Click"
                    Background="White" Foreground="#2196F3"/>
            <Button Content="Refresh" Margin="5" Padding="10,0" Click="RefreshView_Click"
                    Background="White" Foreground="#2196F3"/>
        </ToolBar>

        <!-- Document Grid -->
        <DataGrid x:Name="DocumentGrid" Margin="10" AutoGenerateColumns="False"
                  CanUserSortColumns="True" CanUserResizeColumns="True"
                  SelectionChanged="DocumentGrid_SelectionChanged"
                  RowHeaderWidth="0" GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Document Number" Binding="{Binding DocumentNumber}" Width="200"/>
                <DataGridTextColumn Header="Document Type" Binding="{Binding DocumentType}" Width="60"/>
                <DataGridTextColumn Header="Package" Binding="{Binding Package}" Width="60"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="40"/>
                <DataGridTemplateColumn Header="Issue / Revision" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <ItemsControl ItemsSource="{Binding RevisionHistory}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Value.Revision}" 
                                                       Grid.Column="{Binding Key, Converter={StaticResource DateToColumnConverter}}"
                                                       TextAlignment="Center"
                                                       FontWeight="Bold"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Padding="5"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
        </DataGrid>
    </DockPanel>
</Window>
