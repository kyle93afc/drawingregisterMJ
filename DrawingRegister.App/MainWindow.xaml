<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DrawingRegister.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrawingRegister.App"
        xmlns:converters="clr-namespace:DrawingRegister.App.Converters"
        mc:Ignorable="d"
        Icon="pack://application:,,,/DrawingRegister.App;component/Assets/icon.ico"
        Title="DOCUMENT AND DRAWING REGISTER v1.0.6" Height="800" Width="1200"
        Background="{StaticResource Slate50Brush}">
    <Window.Resources>
        <converters:DateToColumnConverter x:Key="DateToColumnConverter"/>
        <converters:LatestRevisionConverter x:Key="LatestRevisionConverter"/>
        <converters:RevisionColorConverter x:Key="RevisionColorConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:LatestRevisionDateConverter x:Key="LatestRevisionDateConverter"/>
        <converters:RevisionAtDateConverter x:Key="RevisionAtDateConverter"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header Card -->
            <RowDefinition Height="Auto"/>  <!-- Primary Actions + Search -->
            <RowDefinition Height="Auto"/>  <!-- Filters Card -->
            <RowDefinition Height="Auto"/>  <!-- Issue Information Card -->
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="*"/>     <!-- Documents Grid -->
            <RowDefinition Height="Auto"/>  <!-- Revision Timeline -->
        </Grid.RowDefinitions>

        <!-- ========================================= -->
        <!-- HEADER CARD: Logo + Project Info          -->
        <!-- ========================================= -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo + Title -->
                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,12">
                    <Image Source="pack://application:,,,/DrawingRegister.App;component/Resources/company-logo.png"
                           Height="36" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Document &amp; Drawing Register" Style="{StaticResource HeadingLarge}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- About Button -->
                <Button Grid.Row="0" Grid.Column="2"
                        Content="?" Width="32" Height="32"
                        FontSize="15" FontWeight="Bold"
                        ToolTip="About this application"
                        Click="About_Click"
                        Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Padding="0"/>

                <!-- Project Fields -->
                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 1: Discipline + Reg No + Project No + Client No -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Discipline" Style="{StaticResource SectionLabel}"/>
                    <ComboBox x:Name="DisciplineCombo" Grid.Row="0" Grid.Column="1" Height="30"
                              SelectionChanged="DisciplineCombo_SelectionChanged">
                        <ComboBoxItem Tag="Z" Content="General/Multi-discipline"/>
                        <ComboBoxItem Tag="C" Content="Civil"/>
                        <ComboBoxItem Tag="S" Content="Structural"/>
                        <ComboBoxItem Tag="A" Content="Architectural"/>
                    </ComboBox>

                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Project No" Style="{StaticResource SectionLabel}"/>
                    <TextBox x:Name="ProjectNoBox" Grid.Row="0" Grid.Column="4" Height="30"/>

                    <TextBlock Grid.Row="0" Grid.Column="6" Text="Client No" Style="{StaticResource SectionLabel}"/>
                    <TextBox x:Name="ClientNoBox" Grid.Row="0" Grid.Column="7" Height="30"/>

                    <TextBlock Grid.Row="0" Grid.Column="9" Text="Reg No" Style="{StaticResource SectionLabel}"/>
                    <TextBox x:Name="RegNoBox" Grid.Row="0" Grid.Column="10" Height="30" IsReadOnly="True"/>

                    <!-- Row 2: Project Name -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Project Name" Style="{StaticResource SectionLabel}"/>
                    <TextBox x:Name="ProjectNameBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="10" Height="30"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ========================================= -->
        <!-- PRIMARY ACTIONS + SEARCH BAR              -->
        <!-- ========================================= -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Primary Actions -->
            <Button Grid.Column="0" Content="Scan PDF Folder" Click="ImportDocuments_Click"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Height="34"/>
            <Button Grid.Column="1" Content="Save Project" Click="SaveProject_Click"
                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Height="34"/>

            <!-- Search Bar (right-aligned) -->
            <TextBlock Grid.Column="2" Text="Search" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" Margin="0,0,8,0"/>
            <TextBox x:Name="SearchBox" Grid.Column="3" Width="220" TextChanged="SearchBox_TextChanged" Height="30" Margin="0,0,8,0"/>
            <ComboBox x:Name="SearchTypeCombo" Grid.Column="4" Width="130" Height="30" SelectionChanged="SearchTypeCombo_SelectionChanged">
                <ComboBoxItem Content="Document No"/>
                <ComboBoxItem Content="Description"/>
                <ComboBoxItem Content="Package"/>
                <ComboBoxItem Content="Type"/>
            </ComboBox>
        </Grid>

        <!-- ========================================= -->
        <!-- FILTERS CARD                              -->
        <!-- ========================================= -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <StackPanel>
                <!-- Date Filters Row -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Date Range" Style="{StaticResource SectionLabel}" Width="80"/>
                    <DatePicker x:Name="StartDatePicker" Width="140" Height="28" Margin="0,0,8,0"/>
                    <TextBlock Text="to" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" FontSize="12"/>
                    <DatePicker x:Name="EndDatePicker" Width="140" Height="28" Margin="0,0,8,0"/>
                    <Button Content="Apply" Click="DateFilter_Click" Style="{StaticResource GhostButton}" Height="28" Padding="12,4" Margin="0,0,4,0"/>
                    <Button Content="Clear" Click="ClearDateFilter_Click" Style="{StaticResource ToolbarButton}" Height="28" Padding="12,4"/>
                </StackPanel>

                <Separator Style="{StaticResource CardDivider}"/>

                <!-- Issue Filters Row -->
                <WrapPanel Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="Issue Date" Style="{StaticResource SectionLabel}"/>
                        <ComboBox x:Name="IssueDateFilter" Width="150" Height="28" SelectionChanged="IssueDateFilter_SelectionChanged">
                            <ComboBoxItem Content="All Dates"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Subfolder filter (conditional - visibility controlled by code-behind) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock x:Name="SubfolderFilterLabel" Text="Subfolder" Style="{StaticResource SectionLabel}" Visibility="Collapsed"/>
                        <ComboBox x:Name="SubfolderFilterCombo" Width="200" Height="28" SelectionChanged="SubfolderFilterCombo_SelectionChanged" Visibility="Collapsed"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="Purpose" Style="{StaticResource SectionLabel}"/>
                        <ComboBox x:Name="PurposeOfIssueFilter" Width="130" Height="28" SelectionChanged="PurposeOfIssueFilter_SelectionChanged">
                            <ComboBoxItem Content="All"/>
                            <ComboBoxItem Content="A - Approval"/>
                            <ComboBoxItem Content="C - Construction"/>
                            <ComboBoxItem Content="I - Information"/>
                            <ComboBoxItem Content="T - Tender"/>
                            <ComboBoxItem Content="W - Warrant"/>
                            <ComboBoxItem Content="P - Planning"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Purpose Indicators (refined as chips) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center">
                        <Border x:Name="PurposeA" Width="24" Height="24" CornerRadius="4" Background="Transparent" BorderBrush="{StaticResource Slate300Brush}" BorderThickness="1" Margin="2,0">
                            <TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Slate500Brush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="PurposeC" Width="24" Height="24" CornerRadius="4" Background="Transparent" BorderBrush="{StaticResource Slate300Brush}" BorderThickness="1" Margin="2,0">
                            <TextBlock Text="C" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Slate500Brush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="PurposeI" Width="24" Height="24" CornerRadius="4" Background="Transparent" BorderBrush="{StaticResource Slate300Brush}" BorderThickness="1" Margin="2,0">
                            <TextBlock Text="I" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Slate500Brush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="PurposeT" Width="24" Height="24" CornerRadius="4" Background="Transparent" BorderBrush="{StaticResource Slate300Brush}" BorderThickness="1" Margin="2,0">
                            <TextBlock Text="T" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Slate500Brush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="PurposeW" Width="24" Height="24" CornerRadius="4" Background="Transparent" BorderBrush="{StaticResource Slate300Brush}" BorderThickness="1" Margin="2,0">
                            <TextBlock Text="W" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Slate500Brush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="PurposeP" Width="24" Height="24" CornerRadius="4" Background="Transparent" BorderBrush="{StaticResource Slate300Brush}" BorderThickness="1" Margin="2,0">
                            <TextBlock Text="P" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Slate500Brush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="Method" Style="{StaticResource SectionLabel}"/>
                        <ComboBox x:Name="MethodOfIssueFilter" Width="130" Height="28" SelectionChanged="MethodOfIssueFilter_SelectionChanged">
                            <ComboBoxItem Content="All"/>
                            <ComboBoxItem Content="E - Email"/>
                            <ComboBoxItem Content="S - SharePoint"/>
                            <ComboBoxItem Content="P - Post"/>
                            <ComboBoxItem Content="H - Hand"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Method Indicators -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center">
                        <Border x:Name="MethodE" Width="24" Height="24" CornerRadius="4" Background="Transparent" BorderBrush="{StaticResource Slate300Brush}" BorderThickness="1" Margin="2,0">
                            <TextBlock Text="E" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Slate500Brush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="MethodS" Width="24" Height="24" CornerRadius="4" Background="Transparent" BorderBrush="{StaticResource Slate300Brush}" BorderThickness="1" Margin="2,0">
                            <TextBlock Text="S" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Slate500Brush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="MethodP" Width="24" Height="24" CornerRadius="4" Background="Transparent" BorderBrush="{StaticResource Slate300Brush}" BorderThickness="1" Margin="2,0">
                            <TextBlock Text="P" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Slate500Brush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="MethodH" Width="24" Height="24" CornerRadius="4" Background="Transparent" BorderBrush="{StaticResource Slate300Brush}" BorderThickness="1" Margin="2,0">
                            <TextBlock Text="H" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Slate500Brush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="Issued By" Style="{StaticResource SectionLabel}"/>
                        <TextBox x:Name="IssuedByFilter" Width="44" Height="28" MaxLength="2" CharacterCasing="Upper" TextChanged="IssuedByFilter_TextChanged"/>
                    </StackPanel>

                    <Button Content="Save Issue Details" Click="SaveIssueDetails_Click" Height="28" Padding="12,4"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,4"/>

                    <Button x:Name="ViewDistributionButton" Content="View Distribution" Click="ViewDistribution_Click"
                            Height="28" Padding="12,4" Style="{StaticResource GhostButton}" Margin="0,0,0,4"/>
                </WrapPanel>

                <!-- Distribution Summary (shows when relevant) -->
                <Border x:Name="DistributionSummaryBorder" Background="{StaticResource Slate50Brush}"
                        BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="6"
                        Padding="12,6" Margin="0,8,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Distribution:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Slate700Brush}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="DistributionSummaryText" Text="No recipients" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ========================================= -->
        <!-- ISSUE INFORMATION CARD                    -->
        <!-- ========================================= -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Distribution Info -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Distribution:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Slate700Brush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DistributionInfoText" Text="No recipients selected"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>

                <Separator Grid.Row="1" Style="{StaticResource CardDivider}" Margin="0,2"/>

                <!-- Purpose / Method / Issued By / Date row -->
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <TextBlock Text="Purpose" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Slate600Brush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <Border BorderBrush="{StaticResource Slate300Brush}" BorderThickness="1" CornerRadius="4" Width="28" Height="28" Margin="0,0,20,0">
                        <TextBlock x:Name="CurrentPurposeIndicator" Text="" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                    </Border>

                    <TextBlock Text="Method" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Slate600Brush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <Border BorderBrush="{StaticResource Slate300Brush}" BorderThickness="1" CornerRadius="4" Width="28" Height="28" Margin="0,0,20,0">
                        <TextBlock x:Name="CurrentMethodIndicator" Text="" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                    </Border>

                    <TextBlock Text="Issued By" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Slate600Brush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <Border BorderBrush="{StaticResource Slate300Brush}" BorderThickness="1" CornerRadius="4" Width="28" Height="28" Margin="0,0,20,0">
                        <TextBlock x:Name="CurrentIssuedByIndicator" Text="" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                    </Border>

                    <TextBlock Text="Date of Issue" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Slate600Brush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <Border BorderBrush="{StaticResource Slate300Brush}" BorderThickness="1" CornerRadius="4" Padding="8,2" Height="28">
                        <TextBlock x:Name="CurrentIssueDate" Text="{Binding ElementName=IssueDateFilter, Path=SelectedItem.Content}"
                                  VerticalAlignment="Center" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================= -->
        <!-- SECONDARY TOOLBAR                         -->
        <!-- ========================================= -->
        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource Slate200Brush}"
                BorderThickness="1" CornerRadius="6" Padding="4,2" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="Refresh" Click="RefreshView_Click" Style="{StaticResource ToolbarButton}" Margin="2,0"/>
                <Button Content="Rescan Folder" Click="RescanFolder_Click" Style="{StaticResource ToolbarButton}" Margin="2,0"/>
                <Rectangle Width="1" Fill="{StaticResource Slate200Brush}" Margin="4,4"/>
                <Button Content="Distribution" Click="ManageDistribution_Click" Style="{StaticResource ToolbarButton}" Margin="2,0"/>
                <Button Content="Batch Edit" Click="BatchEdit_Click" Style="{StaticResource ToolbarButton}" Margin="2,0"/>
                <Rectangle Width="1" Fill="{StaticResource Slate200Brush}" Margin="4,4"/>
                <Button Content="PDF Report" Click="GeneratePdfReport_Click" Style="{StaticResource ToolbarButton}" Margin="2,0"/>
                <Button Content="Export CSV" Click="ExportCsv_Click" Style="{StaticResource ToolbarButton}" Margin="2,0"/>
                <Rectangle Width="1" Fill="{StaticResource Slate200Brush}" Margin="4,4"/>
                <Button x:Name="RemoveDocumentButton" Content="Remove Entry" Click="RemoveDocumentButton_Click"
                        Style="{StaticResource DangerButton}" Margin="2,0" Padding="10,4" Height="28" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- ========================================= -->
        <!-- DOCUMENTS DATAGRID                        -->
        <!-- ========================================= -->
        <Border Grid.Row="5" Background="White" BorderBrush="{StaticResource Slate200Brush}"
                BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" ClipToBounds="True">
            <DataGrid x:Name="DocumentGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Extended"
                      SelectionChanged="DocumentGrid_SelectionChanged"
                      PreviewMouseRightButtonDown="DocumentGrid_PreviewMouseRightButtonDown"
                      AlternationCount="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      ColumnWidth="Auto"
                      BorderThickness="0"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      Background="White">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Edit Document" Click="EditDocument_Click"/>
                        <MenuItem Header="Manage Distribution" Click="ManageDistribution_Click"/>
                        <Separator/>
                        <MenuItem Header="Set Paper Size">
                            <MenuItem Header="A0" Click="SetPaperSize_Click" Tag="A0"/>
                            <MenuItem Header="A1" Click="SetPaperSize_Click" Tag="A1"/>
                            <MenuItem Header="A2" Click="SetPaperSize_Click" Tag="A2"/>
                            <MenuItem Header="A3" Click="SetPaperSize_Click" Tag="A3"/>
                            <MenuItem Header="A4" Click="SetPaperSize_Click" Tag="A4"/>
                            <MenuItem Header="A5" Click="SetPaperSize_Click" Tag="A5"/>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="DOCUMENT NO"
                                      Binding="{Binding DocumentNumber}"
                                      Width="Auto"/>
                    <DataGridTextColumn Header="DESCRIPTION"
                                      Binding="{Binding Description}"
                                      Width="Auto"/>
                    <DataGridTextColumn Header="PACKAGE"
                                      Binding="{Binding Package}"
                                      Width="Auto"/>
                    <DataGridTextColumn Header="TYPE"
                                      Binding="{Binding DocumentType}"
                                      Width="Auto"/>
                    <DataGridTextColumn Header="SIZE"
                                      Binding="{Binding Size}"
                                      Width="Auto"/>
                    <DataGridTextColumn Header="LATEST REV"
                                      Binding="{Binding RevisionHistory, Converter={StaticResource LatestRevisionConverter}}"
                                      Width="Auto"/>
                    <DataGridTextColumn Header="LAST ISSUED"
                                      Binding="{Binding RevisionHistory, Converter={StaticResource LatestRevisionDateConverter}}"
                                      Width="Auto"/>
                    <!-- Revision columns will be added dynamically -->
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ========================================= -->
        <!-- REVISION TIMELINE                         -->
        <!-- ========================================= -->
        <ScrollViewer Grid.Row="6"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Margin="0,0,0,0"
                      MaxHeight="160">
            <ItemsControl x:Name="RevisionTimeline"
                          ItemsSource="{Binding SelectedDocument.RevisionHistory}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8"
                                Margin="0,4,8,4"
                                Background="White"
                                BorderBrush="{StaticResource Slate200Brush}"
                                BorderThickness="1"
                                Effect="{StaticResource CardShadow}"
                                Width="140"
                                MouseLeftButtonDown="RevisionTimeline_MouseDoubleClick"
                                Cursor="Hand">
                            <StackPanel>
                                <!-- Date Header -->
                                <Border Background="{StaticResource Slate700Brush}" CornerRadius="8,8,0,0" Padding="8,6">
                                    <TextBlock Text="{Binding Key, StringFormat=dd/MM/yyyy}"
                                               Foreground="White" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"/>
                                </Border>

                                <!-- Revision Content -->
                                <StackPanel Margin="10,8,10,10">
                                    <!-- Revision Badge -->
                                    <Border Background="{StaticResource BrandRedLightBrush}" CornerRadius="4"
                                            Padding="6,2" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Value.Revision}" FontSize="15"
                                                   FontWeight="Bold" Foreground="{StaticResource BrandRedBrush}" HorizontalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Text="{Binding Value.Purpose}" FontSize="11"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>

                                    <TextBlock Text="{Binding Value.Method}" FontSize="10" FontStyle="Italic"
                                               HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>

                                    <TextBlock Text="{Binding Value.IssuedBy}" FontSize="11" Margin="0,4,0,0"
                                               Foreground="{StaticResource Slate600Brush}" HorizontalAlignment="Center" FontWeight="SemiBold"/>

                                    <Button Content="Edit" Margin="0,6,0,0" Padding="8,2"
                                            Style="{StaticResource GhostButton}" FontSize="11" Height="24"
                                            Click="EditRevision_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</Window>
