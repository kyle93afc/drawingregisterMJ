<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DrawingRegister.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrawingRegister.App"
        xmlns:converters="clr-namespace:DrawingRegister.App.Converters"
        mc:Ignorable="d"
        Title="SER DOCUMENT AND DRAWING REGISTER" Height="800" Width="1200">
    <Window.Resources>
        <converters:DateToColumnConverter x:Key="DateToColumnConverter"/>
        <converters:LatestRevisionConverter x:Key="LatestRevisionConverter"/>
        <converters:RevisionColorConverter x:Key="RevisionColorConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <!-- Styles -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#ddd"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#f2f2f2"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ddd"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Revision Cell Template -->
        <DataTemplate x:Key="RevisionCellTemplate">
            <Border BorderBrush="#ddd" BorderThickness="1" Width="120" Background="White">
                <TextBlock Text="{Binding}" Padding="8" TextWrapping="Wrap"/>
            </Border>
        </DataTemplate>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Info -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 1 -->
            <TextBlock Text="Discipline:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <TextBox x:Name="DisciplineBox" Grid.Row="0" Grid.Column="1" Margin="0,0,20,5"/>
            <TextBlock Text="Reg No:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <TextBox x:Name="RegNoBox" Grid.Row="0" Grid.Column="3" Width="300" Margin="0,0,0,5"/>

            <!-- Row 2 -->
            <TextBlock Text="Project No:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <TextBox x:Name="ProjectNoBox" Grid.Row="1" Grid.Column="1" Margin="0,0,20,5"/>
            <TextBlock Text="Client No:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <TextBox x:Name="ClientNoBox" Grid.Row="1" Grid.Column="3" Margin="0,0,0,5"/>

            <!-- Row 3 -->
            <TextBlock Text="Project Name:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <TextBox x:Name="ProjectNameBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,5"/>
        </Grid>

        <!-- Distribution Header -->
        <TextBlock Grid.Row="1" Text="DISTRIBUTION" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Import Documents" Click="ImportDocuments_Click" Padding="15,5" Margin="0,0,10,0"/>
            <Button Content="Refresh View" Click="RefreshView_Click" Padding="15,5"/>
        </StackPanel>

        <!-- Move Date Filters to New Row -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Filter by Date:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <DatePicker x:Name="StartDatePicker" Width="120" Margin="0,0,10,0"/>
            <DatePicker x:Name="EndDatePicker" Width="120" Margin="0,0,10,0"/>
            <Button Content="Apply Filter" Click="DateFilter_Click" Padding="10,3"/>
            <Button Content="Clear Filter" Click="ClearDateFilter_Click" Padding="10,3" 
                    Background="#FFE0E0E0"/>
        </StackPanel>

        <!-- Documents Grid -->
        <DataGrid x:Name="DocumentGrid" 
                  Grid.Row="4" 
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="DocumentGrid_SelectionChanged"
                  AlternationCount="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  BorderThickness="1"
                  BorderBrush="#ddd">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Document No" Binding="{Binding DocumentNumber}" Width="200"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Package" Binding="{Binding Package}" Width="100"/>
                <DataGridTextColumn Header="Type" Binding="{Binding DocumentType}" Width="100"/>
                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80"/>
                <DataGridTextColumn Header="Latest Rev" 
                                  Binding="{Binding RevisionHistory, Converter={StaticResource LatestRevisionConverter}}"
                                  Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Revision Timeline -->
        <ScrollViewer Grid.Row="5" 
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,10,0,0">
            <ItemsControl x:Name="RevisionTimeline" 
                          ItemsSource="{Binding SelectedDocument.RevisionHistory}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#4CAF50" BorderThickness="1" 
                                Margin="4" Padding="0" 
                                Background="{Binding Value.Purpose, Converter={StaticResource RevisionColorConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Key, StringFormat=yyyy-MM-dd}" 
                                           Background="#4CAF50" Foreground="White"
                                           Padding="4" FontWeight="Bold" TextAlignment="Center"/>
                                
                                <StackPanel Margin="8">
                                    <TextBlock Text="{Binding Value.Revision}" FontSize="16" 
                                               FontWeight="Bold" HorizontalAlignment="Center"/>
                                    
                                    <TextBlock Text="{Binding Value.Purpose}" Margin="0,5" 
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                    
                                    <TextBlock Text="{Binding Value.Method}" FontStyle="Italic"
                                               HorizontalAlignment="Center"/>
                                    
                                    <TextBlock Text="{Binding Value.IssuedBy}" Margin="0,5"
                                               Foreground="#444" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
