<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DrawingRegister.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrawingRegister.App"
        xmlns:converters="clr-namespace:DrawingRegister.App.Converters"
        mc:Ignorable="d"
        Title="SER DOCUMENT AND DRAWING REGISTER" Height="800" Width="1200">
    <Window.Resources>
        <converters:DateToColumnConverter x:Key="DateToColumnConverter"/>
        <converters:LatestRevisionConverter x:Key="LatestRevisionConverter"/>
        <converters:RevisionColorConverter x:Key="RevisionColorConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:LatestRevisionDateConverter x:Key="LatestRevisionDateConverter"/>
        <converters:RevisionAtDateConverter x:Key="RevisionAtDateConverter"/>
        
        <!-- Global Effects -->
        <DropShadowEffect x:Key="MaterialDropShadow" 
                         BlurRadius="4" 
                         Direction="270" 
                         ShadowDepth="2" 
                         Opacity="0.2" 
                         Color="#000000"/>
        
        <!-- Button Style -->
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#5a6268"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Effect="{StaticResource MaterialDropShadow}">
                            <ContentPresenter x:Name="contentPresenter" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            TextBlock.FontWeight="SemiBold"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border"
                                                      Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                      To="#4a5258" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border"
                                                      Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                      To="#5a6268" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3d444a"/>
                                <Setter TargetName="contentPresenter" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDBDBD"/>
                                <Setter Property="Foreground" Value="#757575"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}"/>
        
        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#6c757d"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                          To="#5a6268" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                          To="#6c757d" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#545b62"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Styles -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#eb1845"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#ddd"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RotatedColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <StackPanel>
                                    <TextBlock Text="{TemplateBinding Content}">
                                        <TextBlock.LayoutTransform>
                                            <RotateTransform Angle="-90"/>
                                        </TextBlock.LayoutTransform>
                                        <TextBlock.Margin>2,25,2,5</TextBlock.Margin>
                                        <TextBlock.TextAlignment>Left</TextBlock.TextAlignment>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#f2f2f2"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ddd"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Revision Cell Template -->
        <DataTemplate x:Key="RevisionCellTemplate">
            <Border BorderBrush="#ddd" BorderThickness="1" Width="120" Background="White">
                <TextBlock Text="{Binding}" Padding="8" TextWrapping="Wrap"/>
            </Border>
        </DataTemplate>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- Add Revision Edit Dialog -->
        <Style x:Key="RevisionEditDialog" TargetType="Window">
            <Setter Property="Height" Value="300"/>
            <Setter Property="Width" Value="400"/>
            <Setter Property="WindowStyle" Value="ToolWindow"/>
            <Setter Property="ResizeMode" Value="NoResize"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header Info -->
            <RowDefinition Height="Auto"/>  <!-- Distribution Header -->
            <RowDefinition Height="Auto"/>  <!-- Distribution Grid -->
            <RowDefinition Height="Auto"/>  <!-- Action Buttons -->
            <RowDefinition Height="Auto"/>  <!-- Search Panel -->
            <RowDefinition Height="Auto"/>  <!-- Date Filter -->
            <RowDefinition Height="*"/>     <!-- Documents Grid -->
            <RowDefinition Height="Auto"/>  <!-- Revision Timeline -->
        </Grid.RowDefinitions>

        <!-- Header Info -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo -->
            <Image Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" 
                   Source="/Resources/company-logo.png" 
                   Height="100" 
                   HorizontalAlignment="Left" 
                   Margin="0,0,0,20"/>

            <!-- Row 1 -->
            <TextBlock Text="DISCIPLINE:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <TextBox x:Name="DisciplineBox" Grid.Row="1" Grid.Column="1" Margin="0,0,20,5"/>
            <TextBlock Text="REG NO:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <TextBox x:Name="RegNoBox" Grid.Row="1" Grid.Column="3" Width="300" Margin="0,0,0,5"/>

            <!-- Row 2 -->
            <TextBlock Text="PROJECT NO:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <TextBox x:Name="ProjectNoBox" Grid.Row="2" Grid.Column="1" Margin="0,0,20,5"/>
            <TextBlock Text="CLIENT NO:" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <TextBox x:Name="ClientNoBox" Grid.Row="2" Grid.Column="3" Margin="0,0,0,5"/>

            <!-- Row 3 -->
            <TextBlock Text="PROJECT NAME:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <TextBox x:Name="ProjectNameBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,5"/>
        </Grid>

        <!-- Distribution Header -->
        <TextBlock Grid.Row="1" Text="DISTRIBUTION" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <!-- Distribution Grid -->
        <DataGrid x:Name="DistributionGrid" 
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  Margin="0,0,0,20"
                  AlternationCount="2"
                  CanUserAddRows="True"
                  Height="Auto"
                  MinHeight="100"
                  MaxHeight="200"
                  BorderThickness="1"
                  BorderBrush="#ddd"
                  HorizontalScrollBarVisibility="Auto"
                  AddingNewItem="DistributionGrid_AddingNewItem">
            <DataGrid.Columns>
                <DataGridTextColumn Header="CLIENT NAME" 
                                  Binding="{Binding ClientName}"
                                  Width="*"
                                  MinWidth="120"/>
                <DataGridTextColumn Header="DESCRIPTION" 
                                  Width="*"
                                  MinWidth="200"
                                  IsReadOnly="True"/>
                <DataGridTextColumn Header="PACKAGE" 
                                  Width="Auto"
                                  MinWidth="80"
                                  IsReadOnly="True"/>
                <DataGridTextColumn Header="TYPE" 
                                  Width="Auto"
                                  MinWidth="80"
                                  IsReadOnly="True"/>
                <DataGridTextColumn Header="SIZE" 
                                  Width="Auto"
                                  MinWidth="50"
                                  IsReadOnly="True"/>
                <DataGridTextColumn Header="LATEST REV" 
                                  Width="Auto"
                                  MinWidth="80"
                                  IsReadOnly="True"/>
                <DataGridTextColumn Header="LAST DATE OF ISSUE" 
                                  Width="Auto"
                                  MinWidth="100"
                                  IsReadOnly="True"/>
                <!-- Revision columns will be added dynamically -->
            </DataGrid.Columns>
        </DataGrid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="SCAN OUTGOING PDF FOLDER" Click="ImportDocuments_Click"/>
            <Button Content="SAVE PROJECT" Click="SaveProject_Click"/>
            <Button Content="REFRESH VIEW" Click="RefreshView_Click"/>
            <Button Content="GENERATE PDF REPORT" Click="GeneratePdfReport_Click"/>
        </StackPanel>

        <!-- Search Panel -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="SEARCH:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="SearchBox" Width="200" Margin="0,0,10,0" TextChanged="SearchBox_TextChanged"/>
            <ComboBox x:Name="SearchTypeCombo" Width="200" Margin="0,0,10,0" SelectedIndex="0">
                <ComboBoxItem Content="DOCUMENT NO"/>
                <ComboBoxItem Content="DESCRIPTION"/>
                <ComboBoxItem Content="PACKAGE"/>
                <ComboBoxItem Content="TYPE"/>
            </ComboBox>
        </StackPanel>

        <!-- Move Date Filters to New Row -->
        <StackPanel Grid.Row="5" Orientation="Vertical" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="FILTER BY DATE:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <DatePicker x:Name="StartDatePicker" Width="120" Margin="0,0,10,0"/>
                <DatePicker x:Name="EndDatePicker" Width="120" Margin="0,0,10,0"/>
                <Button Content="APPLY FILTER" Click="DateFilter_Click"/>
                <Button Content="CLEAR FILTER" Click="ClearDateFilter_Click" Style="{StaticResource BaseButtonStyle}"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="FILTER BY DATE OF ISSUE:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="IssueDateFilter" Width="200" Margin="0,0,10,0" SelectionChanged="IssueDateFilter_SelectionChanged">
                    <ComboBoxItem Content="All Dates"/>
                </ComboBox>

                <TextBlock Text="PURPOSE OF ISSUE:" VerticalAlignment="Center" Margin="20,0,10,0"/>
                <ComboBox x:Name="PurposeOfIssueFilter" Width="120" Margin="0,0,10,0">
                    <ComboBoxItem Content="All"/>
                    <ComboBoxItem Content="Approval"/>
                    <ComboBoxItem Content="Construction"/>
                    <ComboBoxItem Content="Draft"/>
                    <ComboBoxItem Content="Feasibility"/>
                    <ComboBoxItem Content="Information"/>
                    <ComboBoxItem Content="Planning"/>
                    <ComboBoxItem Content="Tender"/>
                    <ComboBoxItem Content="Warrant"/>
                </ComboBox>

                <TextBlock Text="METHOD OF ISSUE:" VerticalAlignment="Center" Margin="20,0,10,0"/>
                <ComboBox x:Name="MethodOfIssueFilter" Width="120" Margin="0,0,10,0">
                    <ComboBoxItem Content="All"/>
                    <ComboBoxItem Content="Email"/>
                    <ComboBoxItem Content="Sharepoint"/>
                </ComboBox>

                <TextBlock Text="ISSUED BY:" VerticalAlignment="Center" Margin="20,0,10,0"/>
                <TextBox x:Name="IssuedByFilter" Width="60" Margin="0,0,10,0" MaxLength="2" CharacterCasing="Upper"/>

                <Button Content="SAVE ISSUE DETAILS" Click="SaveIssueDetails_Click" 
                        Style="{StaticResource BaseButtonStyle}"/>
            </StackPanel>
        </StackPanel>

        <!-- Documents Grid -->
        <DataGrid x:Name="DocumentGrid" 
                  Grid.Row="6" 
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="DocumentGrid_SelectionChanged"
                  AlternationCount="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  BorderThickness="1"
                  BorderBrush="#ddd">
            <DataGrid.Columns>
                <DataGridTextColumn Header="DOCUMENT NO" Binding="{Binding DocumentNumber}" Width="Auto" MinWidth="120"/>
                <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" MinWidth="200"/>
                <DataGridTextColumn Header="PACKAGE" Binding="{Binding Package}" Width="Auto" MinWidth="80"/>
                <DataGridTextColumn Header="TYPE" Binding="{Binding DocumentType}" Width="Auto" MinWidth="80"/>
                <DataGridTextColumn Header="SIZE" Binding="{Binding Size}" Width="Auto" MinWidth="50"/>
                <DataGridTextColumn Header="LATEST REV" 
                                  Binding="{Binding RevisionHistory, Converter={StaticResource LatestRevisionConverter}}"
                                  Width="Auto" MinWidth="80"/>
                <DataGridTextColumn Header="LAST DATE OF ISSUE" 
                                  Binding="{Binding RevisionHistory, Converter={StaticResource LatestRevisionDateConverter}}"
                                  Width="Auto" MinWidth="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Revision Timeline -->
        <ScrollViewer Grid.Row="7" 
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,10,0,0">
            <ItemsControl x:Name="RevisionTimeline" 
                          ItemsSource="{Binding SelectedDocument.RevisionHistory}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#eb1845" BorderThickness="1" 
                                Margin="4" Padding="0" 
                                Background="{Binding Value.Purpose, Converter={StaticResource RevisionColorConverter}}"
                                MouseLeftButtonDown="RevisionTimeline_MouseDoubleClick">
                            <StackPanel>
                                <TextBlock Text="{Binding Key, StringFormat=dd/MM/yyyy}" 
                                           Background="#eb1845" Foreground="White"
                                           Padding="4" FontWeight="Bold" TextAlignment="Center"/>
                                
                                <StackPanel Margin="8">
                                    <TextBlock Text="{Binding Value.Revision}" FontSize="16" 
                                               FontWeight="Bold" HorizontalAlignment="Center"/>
                                    
                                    <TextBlock Text="{Binding Value.Purpose}" Margin="0,5" 
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                    
                                    <TextBlock Text="{Binding Value.Method}" FontStyle="Italic"
                                               HorizontalAlignment="Center"/>
                                    
                                    <TextBlock Text="{Binding Value.IssuedBy}" Margin="0,5"
                                               Foreground="#444" HorizontalAlignment="Center"/>

                                    <Button Content="Edit" Margin="0,5,0,0" Padding="10,2"
                                            Click="EditRevision_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
