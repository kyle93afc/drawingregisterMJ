<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DrawingRegister.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrawingRegister.App"
        xmlns:converters="clr-namespace:DrawingRegister.App.Converters"
        mc:Ignorable="d"
        Title="SER DOCUMENT AND DRAWING REGISTER" Height="800" Width="1200">
    <Window.Resources>
        <converters:DateToColumnConverter x:Key="DateToColumnConverter"/>
        <converters:LatestRevisionConverter x:Key="LatestRevisionConverter"/>
        
        <!-- Styles -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#ddd"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#f2f2f2"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ddd"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Revision Cell Template -->
        <DataTemplate x:Key="RevisionCellTemplate">
            <Border BorderBrush="#ddd" BorderThickness="1" Width="120" Background="White">
                <TextBlock Text="{Binding}" Padding="8" TextWrapping="Wrap"/>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Info -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 1 -->
            <TextBlock Text="Discipline:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <TextBox x:Name="DisciplineBox" Grid.Row="0" Grid.Column="1" Margin="0,0,20,5"/>
            <TextBlock Text="Reg No:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <TextBox x:Name="RegNoBox" Grid.Row="0" Grid.Column="3" Width="300" Margin="0,0,0,5"/>

            <!-- Row 2 -->
            <TextBlock Text="Project No:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <TextBox x:Name="ProjectNoBox" Grid.Row="1" Grid.Column="1" Margin="0,0,20,5"/>
            <TextBlock Text="Client No:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <TextBox x:Name="ClientNoBox" Grid.Row="1" Grid.Column="3" Margin="0,0,0,5"/>

            <!-- Row 3 -->
            <TextBlock Text="Project Name:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <TextBox x:Name="ProjectNameBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,5"/>
        </Grid>

        <!-- Distribution Header -->
        <TextBlock Grid.Row="1" Text="DISTRIBUTION" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Import Documents" Click="ImportDocuments_Click" Padding="15,5" Margin="0,0,10,0"/>
            <Button Content="Refresh View" Click="RefreshView_Click" Padding="15,5"/>
        </StackPanel>

        <!-- Documents Grid -->
        <DataGrid x:Name="DocumentGrid" 
                  Grid.Row="3" 
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="DocumentGrid_SelectionChanged"
                  AlternationCount="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  BorderThickness="1"
                  BorderBrush="#ddd">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Document No" Binding="{Binding DocumentNumber}" Width="200"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Package" Binding="{Binding Package}" Width="100"/>
                <DataGridTextColumn Header="Type" Binding="{Binding DocumentType}" Width="100"/>
                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80"/>
                <DataGridTextColumn Header="Latest Rev" 
                                  Binding="{Binding RevisionHistory, Converter={StaticResource LatestRevisionConverter}}"
                                  Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Revision History -->
        <ScrollViewer Grid.Row="4" 
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Margin="0,10,0,0">
            <Grid x:Name="RevisionHistoryGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ItemsControl Grid.Row="0" x:Name="RevisionDatesRow">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#ddd" BorderThickness="1" Width="120">
                                <TextBlock Text="{Binding}" Padding="8" Background="#f2f2f2"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl Grid.Row="1" x:Name="RevisionPurposeRow">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#ddd" BorderThickness="1" Width="120">
                                <TextBlock Text="{Binding}" Padding="8" TextWrapping="Wrap"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl Grid.Row="2" x:Name="RevisionMethodRow">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#ddd" BorderThickness="1" Width="120">
                                <TextBlock Text="{Binding}" Padding="8" TextWrapping="Wrap"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl Grid.Row="3" x:Name="RevisionIssuedByRow">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#ddd" BorderThickness="1" Width="120">
                                <TextBlock Text="{Binding}" Padding="8" TextWrapping="Wrap"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
