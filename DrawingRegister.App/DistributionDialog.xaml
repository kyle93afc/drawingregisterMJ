<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DrawingRegister.App.DistributionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrawingRegister.App"
        mc:Ignorable="d"
        Title="Manage Distribution Companies" Height="460" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Slate50Brush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Distribution Companies" Style="{StaticResource HeadingLarge}" Margin="4,0,0,16"/>

        <!-- Companies List Card -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Manage the list of companies that can receive document distributions"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                <ListView Grid.Row="1" x:Name="CompaniesList" SelectionMode="Single"
                          BorderThickness="1" BorderBrush="{StaticResource Slate200Brush}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="260"/>
                            <GridViewColumn Header="Category" DisplayMemberBinding="{Binding Category}" Width="260"/>
                        </GridView>
                    </ListView.View>
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{StaticResource Slate700Brush}" Margin="0,6,0,2"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                </ListView>
            </Grid>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="AddCompanyButton" Content="Add Company" Click="AddCompany_Click"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Height="32"/>
                <Button x:Name="EditCompanyButton" Content="Edit Company" Click="EditCompany_Click"
                        Style="{StaticResource GhostButton}" Margin="0,0,8,0" Height="32"/>
                <Button x:Name="DeleteCompanyButton" Content="Delete Company" Click="DeleteCompany_Click"
                        Style="{StaticResource DangerButton}" Height="32"/>
            </StackPanel>

            <Button Grid.Column="1" x:Name="SaveButton" Content="Close" Click="Save_Click"
                    Style="{StaticResource PrimaryButton}" Height="32"/>
        </Grid>
    </Grid>
</Window>
