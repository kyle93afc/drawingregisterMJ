<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DrawingRegister.App.DistributionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrawingRegister.App"
        mc:Ignorable="d"
        Title="Manage Distribution Companies" Height="500" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="White" WindowStyle="None" AllowsTransparency="True">
    <Border BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="10" Background="White"
            Effect="{StaticResource ElevatedShadow}" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="20,14,14,10" MouseLeftButtonDown="Header_DragMove">
                <StackPanel>
                    <TextBlock Text="Distribution Companies" Style="{StaticResource HeadingMedium}"/>
                    <TextBlock Text="Manage the list of companies for document distributions" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="Save_Click" Style="{StaticResource ToolbarButton}" FontSize="14" Width="28" Height="28" Padding="0"/>
            </Grid>

            <!-- Accent Line -->
            <Border Grid.Row="1" Background="{StaticResource BrandRedBrush}" Height="3"/>

            <!-- Companies List -->
            <Grid Grid.Row="2" Margin="20,16,20,12">
                <ListView x:Name="CompaniesList" SelectionMode="Single"
                          BorderThickness="1" BorderBrush="{StaticResource Slate200Brush}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="260"/>
                            <GridViewColumn Header="Category" DisplayMemberBinding="{Binding Category}" Width="260"/>
                        </GridView>
                    </ListView.View>
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{StaticResource Slate700Brush}" Margin="0,6,0,2"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                </ListView>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="3" Background="{StaticResource Slate50Brush}" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,1,0,0" Padding="20,12,20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="AddCompanyButton" Content="Add Company" Click="AddCompany_Click"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Height="36"/>
                        <Button x:Name="EditCompanyButton" Content="Edit" Click="EditCompany_Click"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0" Height="36"/>
                        <Button x:Name="DeleteCompanyButton" Content="Delete" Click="DeleteCompany_Click"
                                Style="{StaticResource DangerButton}" Height="36"/>
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="SaveButton" Content="Close" Click="Save_Click"
                            Style="{StaticResource PrimaryButton}" Height="36"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
