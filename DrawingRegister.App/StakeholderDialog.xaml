<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DrawingRegister.App.StakeholderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrawingRegister.App"
        mc:Ignorable="d"
        Title="Stakeholder Details" Height="240" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White" WindowStyle="None" AllowsTransparency="True">
    <Border BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="10" Background="White"
            Effect="{StaticResource ElevatedShadow}" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="20,14,14,10" MouseLeftButtonDown="Header_DragMove">
                <TextBlock Text="Stakeholder Details" Style="{StaticResource HeadingMedium}" VerticalAlignment="Center"/>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="Cancel_Click" Style="{StaticResource ToolbarButton}" FontSize="14" Width="28" Height="28" Padding="0"/>
            </Grid>

            <!-- Accent Line -->
            <Border Grid.Row="1" Background="{StaticResource BrandRedBrush}" Height="3"/>

            <!-- Content -->
            <StackPanel Grid.Row="2" Margin="20,16,20,8">
                <TextBlock Text="Name" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                <TextBox x:Name="NameTextBox" Height="30" Margin="0,0,0,12"/>

                <TextBlock Text="Company" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                <TextBox x:Name="CompanyTextBox" Height="30"/>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="3" Background="{StaticResource Slate50Brush}" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,1,0,0" Padding="20,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click"
                            Style="{StaticResource GhostButton}" Height="30" Margin="0,0,8,0"/>
                    <Button x:Name="SaveButton" Content="Save" Click="Save_Click"
                            Style="{StaticResource PrimaryButton}" Height="30"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
