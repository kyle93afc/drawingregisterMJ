<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DrawingRegister.App.DistributionInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrawingRegister.App"
        mc:Ignorable="d"
        Title="Distribution Information" Height="440" Width="580"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Slate50Brush}">
    <Window.Resources>
        <!-- Category Header Style -->
        <Style x:Key="CategoryHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Slate800Brush}"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>

        <!-- Distribution Item Style -->
        <Style x:Key="DistributionItemStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Distribution Information" Style="{StaticResource HeadingLarge}" Margin="4,0,0,12"/>

        <!-- Date Card -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Date of Issue" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="DateOfIssueText" Text="01/01/2023" FontSize="14" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Distribution List Card -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DistributionPanel">
                    <TextBlock Text="Clients" Style="{StaticResource CategoryHeaderStyle}"/>
                    <Grid Style="{StaticResource DistributionItemStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Example Client Ltd" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="5 documents" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBlock Text="Contractors" Style="{StaticResource CategoryHeaderStyle}"/>
                    <Grid Style="{StaticResource DistributionItemStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Example Contractor Ltd" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="3 documents" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Summary + Close -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Total Recipients:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Slate600Brush}" Margin="0,0,4,0"/>
                <TextBlock x:Name="TotalRecipientsText" Text="0" FontSize="12" Margin="0,0,16,0"/>
                <TextBlock Text="Total Documents:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Slate600Brush}" Margin="0,0,4,0"/>
                <TextBlock x:Name="TotalDocumentsText" Text="0" FontSize="12"/>
            </StackPanel>

            <Button Grid.Column="1" Content="Close" Click="CloseButton_Click"
                    Style="{StaticResource PrimaryButton}" Height="32"/>
        </Grid>
    </Grid>
</Window>
