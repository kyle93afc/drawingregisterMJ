<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DrawingRegister.App.DistributionInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrawingRegister.App"
        mc:Ignorable="d"
        Title="Distribution Information" Height="500" Width="700"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Button Style -->
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#5a6268"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter x:Name="contentPresenter" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            TextBlock.FontWeight="SemiBold"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border"
                                                      Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                      To="#4a5258" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border"
                                                      Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                      To="#5a6268" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3d444a"/>
                                <Setter TargetName="contentPresenter" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDBDBD"/>
                                <Setter Property="Foreground" Value="#757575"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#eb1845"/>
        </Style>
        
        <!-- Category Header Style -->
        <Style x:Key="CategoryHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,15,0,5"/>
        </Style>
        
        <!-- Distribution Item Style -->
        <Style x:Key="DistributionItemStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="DISTRIBUTION INFORMATION" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
        
        <!-- Date Information -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Date of Issue: " FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="DateOfIssueText" Text="01/01/2023" FontSize="16" Margin="5,0,0,0"/>
        </StackPanel>
        
        <!-- Distribution List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DistributionPanel">
                <!-- Distribution items will be added here programmatically -->
                
                <!-- Example of how it will look (will be generated in code) -->
                <TextBlock Text="Clients" Style="{StaticResource CategoryHeaderStyle}"/>
                <Grid Style="{StaticResource DistributionItemStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Example Client Ltd" FontSize="14"/>
                    <TextBlock Grid.Column="1" Text="5 documents" FontSize="14" HorizontalAlignment="Right"/>
                </Grid>
                
                <TextBlock Text="Contractors" Style="{StaticResource CategoryHeaderStyle}"/>
                <Grid Style="{StaticResource DistributionItemStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Example Contractor Ltd" FontSize="14"/>
                    <TextBlock Grid.Column="1" Text="3 documents" FontSize="14" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Summary Section -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Summary Information -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Total Recipients: " FontWeight="SemiBold" FontSize="14"/>
                <TextBlock x:Name="TotalRecipientsText" Text="0" FontSize="14" Margin="5,0,15,0"/>
                
                <TextBlock Text="Total Documents: " FontWeight="SemiBold" FontSize="14"/>
                <TextBlock x:Name="TotalDocumentsText" Text="0" FontSize="14" Margin="5,0,0,0"/>
            </StackPanel>
            
            <!-- Close Button -->
            <Button Grid.Column="1" Content="Close" Style="{StaticResource PrimaryButtonStyle}" 
                    Click="CloseButton_Click" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window> 