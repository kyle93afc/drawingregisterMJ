<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DrawingRegister.App.FolderProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder Scan Progress" Height="380" Width="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Slate50Brush}">
    <Grid Margin="16">
        <Border Style="{StaticResource CardStyle}" Padding="20">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Folder Scan Progress" Style="{StaticResource HeadingMedium}" Margin="0,0,0,12"/>
                <ListBox ItemsSource="{Binding FolderStatuses}" Height="240"
                         BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="4,2">
                                <TextBlock Text="{Binding FolderName}" Width="420" FontSize="13"/>
                                <TextBlock Text="{Binding StatusIcon}"
                                          FontSize="16"
                                          Foreground="{Binding StatusColor}"
                                          Margin="10,0,0,0"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
</Window>
