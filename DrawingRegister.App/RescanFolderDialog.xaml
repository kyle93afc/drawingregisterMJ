<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DrawingRegister.App.RescanFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Rescan Folder" Height="380" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Slate50Brush}">
    <Grid Margin="16">
        <Border Style="{StaticResource CardStyle}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Select a folder to rescan" Style="{StaticResource HeadingMedium}" Margin="0,0,0,12"/>

                <ListBox Grid.Row="1" x:Name="FolderListBox" Margin="0,0,0,12" FontSize="13"
                         BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1"
                         MouseDoubleClick="FolderListBox_MouseDoubleClick"/>

                <!-- Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Width="100" Height="32" Margin="0,0,8,0"
                            Click="CancelButton_Click" Style="{StaticResource GhostButton}"/>
                    <Button Content="Rescan" Width="100" Height="32"
                            Click="RescanButton_Click" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
