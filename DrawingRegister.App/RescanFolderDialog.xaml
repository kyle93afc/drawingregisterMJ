<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DrawingRegister.App.RescanFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Rescan Folder" Height="400" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select a folder to rescan:" FontWeight="Bold" Margin="0,0,0,10" FontSize="14"/>

        <ListBox Grid.Row="1" x:Name="FolderListBox" Margin="0,0,0,10" FontSize="14"
                 MouseDoubleClick="FolderListBox_MouseDoubleClick"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="100" Height="35" Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button Content="Rescan" Width="100" Height="35" Click="RescanButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
