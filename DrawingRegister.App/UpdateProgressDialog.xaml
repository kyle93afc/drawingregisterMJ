<Window x:Class="DrawingRegister.App.UpdateProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Downloading Update"
        Height="170" Width="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Background="{StaticResource Slate50Brush}">
    <Grid Margin="16">
        <Border Style="{StaticResource CardStyle}" Padding="20">
            <StackPanel>
                <TextBlock Text="Downloading update, please wait..."
                           FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                <ProgressBar x:Name="ProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                             Foreground="{StaticResource BrandRedBrush}" Background="{StaticResource Slate100Brush}"/>

                <TextBlock x:Name="ProgressText" Text="0%" HorizontalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
