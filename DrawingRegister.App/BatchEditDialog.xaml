<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DrawingRegister.App.BatchEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrawingRegister.App"
        mc:Ignorable="d"
        Title="Batch Edit Drawing Properties" Height="500" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Batch Edit Drawing Properties" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Filter Options -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Filter By:" FontWeight="Bold" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton x:Name="FilterByDate" Content="Issue Date" IsChecked="True" Margin="0,0,15,0" Checked="FilterOption_Changed"/>
                <RadioButton x:Name="FilterByFolder" Content="Subfolder" Margin="0,0,15,0" Checked="FilterOption_Changed"/>
                <RadioButton x:Name="FilterByDateAndFolder" Content="Date and Subfolder" Margin="0,0,15,0" Checked="FilterOption_Changed"/>
            </StackPanel>

            <!-- Date Selection -->
            <StackPanel x:Name="DateSelectionPanel" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Select Issue Date:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="IssueDateCombo" Width="200" SelectionChanged="FilterCriteria_Changed"/>
            </StackPanel>

            <!-- Folder Selection -->
            <StackPanel x:Name="FolderSelectionPanel" Orientation="Horizontal" Margin="0,0,0,10" Visibility="Collapsed">
                <TextBlock Text="Select Subfolder:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="SubfolderCombo" Width="450" SelectionChanged="FilterCriteria_Changed" 
                          ToolTip="Select a subfolder to filter documents"
                          ToolTipService.ShowDuration="5000">
                    <!-- The items will be populated programmatically -->
                </ComboBox>
            </StackPanel>
            
            <!-- Date and Folder Selection -->
            <StackPanel x:Name="DateAndFolderSelectionPanel" Orientation="Vertical" Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Select Issue Date:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="DateAndFolderDateCombo" Width="200" SelectionChanged="DateAndFolderDate_Changed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Select Subfolder:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="DateAndFolderSubfolderCombo" Width="450" SelectionChanged="FilterCriteria_Changed"
                              ToolTip="Select a subfolder for the selected date"
                              ToolTipService.ShowDuration="5000">
                        <!-- The items will be populated programmatically -->
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Edit Properties -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Edit Properties:" FontWeight="Bold" Margin="0,0,0,5"/>
            
            <!-- Purpose of Issue -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Purpose of Issue:" VerticalAlignment="Center" Width="120"/>
                <ComboBox x:Name="PurposeCombo" Width="200" Margin="0,0,10,0">
                    <ComboBoxItem Content="A - Approval"/>
                    <ComboBoxItem Content="C - Construction"/>
                    <ComboBoxItem Content="I - Information"/>
                    <ComboBoxItem Content="P - Planning"/>
                    <ComboBoxItem Content="T - Tender"/>
                    <ComboBoxItem Content="W - Warrant"/>
                </ComboBox>
                <CheckBox x:Name="UpdatePurposeCheck" Content="Update Purpose" IsChecked="True"/>
            </StackPanel>
            
            <!-- Method of Issue -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Method of Issue:" VerticalAlignment="Center" Width="120"/>
                <ComboBox x:Name="MethodCombo" Width="200" Margin="0,0,10,0">
                    <ComboBoxItem Content="E - Email"/>
                    <ComboBoxItem Content="S - SharePoint"/>
                    <ComboBoxItem Content="P - Post"/>
                    <ComboBoxItem Content="H - Hand"/>
                </ComboBox>
                <CheckBox x:Name="UpdateMethodCheck" Content="Update Method" IsChecked="True"/>
            </StackPanel>
            
            <!-- Issued By -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Issued By:" VerticalAlignment="Center" Width="120"/>
                <TextBox x:Name="IssuedByTextBox" Width="200" Margin="0,0,10,0" MaxLength="2" CharacterCasing="Upper"/>
                <CheckBox x:Name="UpdateIssuedByCheck" Content="Update Issued By" IsChecked="True"/>
            </StackPanel>
            
            <!-- Distribution Section -->
            <Expander Header="Distribution" Margin="0,10,0,0">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Select companies to distribute to:" Margin="0,0,0,10"/>
                    
                    <ScrollViewer Grid.Row="1" MaxHeight="200" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DistributionList">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,10,0,5"/>
                                                <Separator/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" 
                                              IsChecked="{Binding IsSelected}" 
                                              Margin="5,2" 
                                              Tag="{Binding Id}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="SelectAllButton" Content="Select All" Width="100" Margin="0,0,10,0" Click="SelectAll_Click"/>
                        <Button x:Name="ClearAllButton" Content="Clear All" Width="100" Click="ClearAll_Click"/>
                    </StackPanel>
                </Grid>
            </Expander>
        </StackPanel>

        <!-- Preview Grid -->
        <GroupBox Grid.Row="3" Header="Affected Documents" Margin="0,0,0,15">
            <DataGrid x:Name="PreviewGrid" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      AlternationCount="2"
                      GridLinesVisibility="All"
                      CanUserSortColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Document No" Binding="{Binding DocumentNumber}" Width="*"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                    <DataGridTextColumn Header="Current Purpose" Binding="{Binding PurposeOfIssue}" Width="*"/>
                    <DataGridTextColumn Header="Current Method" Binding="{Binding MethodOfIssue}" Width="*"/>
                    <DataGridTextColumn Header="Current Issued By" Binding="{Binding IssuedBy}" Width="*"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="AlternationIndex" Value="0">
                                <Setter Property="Background" Value="#FFF8F8F8"/>
                            </Trigger>
                            <Trigger Property="AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#FFEFEFEF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Width="100" Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button x:Name="ApplyButton" Content="Apply Changes" Width="120" Click="ApplyButton_Click"/>
        </StackPanel>
    </Grid>
</Window> 