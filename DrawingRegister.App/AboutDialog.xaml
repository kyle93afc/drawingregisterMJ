<Window x:Class="DrawingRegister.App.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Document and Drawing Register"
        SizeToContent="WidthAndHeight" MinWidth="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Background="{StaticResource Slate50Brush}">
    <Grid Margin="16">
        <Border Style="{StaticResource CardStyle}" Padding="20">
            <StackPanel>
                <!-- Company Logo -->
                <Image Source="pack://application:,,,/DrawingRegister.App;component/Resources/company-logo.png"
                       Height="50" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                <!-- Application Title -->
                <TextBlock Text="Document and Drawing Register"
                           Style="{StaticResource HeadingLarge}"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>

                <!-- Accent Line -->
                <Border Background="{StaticResource BrandRedBrush}" Height="3" Width="40"
                        CornerRadius="2" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <!-- Version -->
                <TextBlock x:Name="VersionText" Text="Version 1.0.0"
                           Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>

                <!-- Description -->
                <TextBlock Text="A professional tool for managing document and drawing registers for engineering projects."
                           TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                <!-- GitHub Link -->
                <TextBlock HorizontalAlignment="Center" Margin="0,0,0,16" FontSize="12">
                    <Hyperlink x:Name="GitHubLink"
                               NavigateUri="https://github.com/kyle93afc/drawingregisterMJ"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        View on GitHub
                    </Hyperlink>
                </TextBlock>

                <!-- Copyright -->
                <TextBlock Text="Copyright (c) 2025 M+J Engineers"
                           Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>

                <!-- Close Button -->
                <Button Content="Close" Width="100" Height="32"
                        HorizontalAlignment="Center" Click="Close_Click"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
