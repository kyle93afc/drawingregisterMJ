<Window x:Class="DrawingRegister.App.CheckingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DrawingRegister.App.Models"
        Title="Check Prints" Height="560" Width="1400"
        MinHeight="400" MinWidth="1000"
        Background="{StaticResource Slate50Brush}"
        Icon="pack://application:,,,/DrawingRegister.App;component/Assets/icon.ico">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Checking folder" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="FolderPathBox" Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center"/>
                <Button Grid.Column="2" Content="Select Folder" Click="SelectFolder_Click"
                        Style="{StaticResource SecondaryButton}" Margin="8,0,4,0"/>
                <Button x:Name="ScanButton" Grid.Column="3" Content="Scan" Click="Scan_Click"
                        Style="{StaticResource PrimaryButton}" Margin="4,0,4,0"/>
                <Button Grid.Column="4" Content="Export CSV" Click="ExportCsv_Click"
                        Style="{StaticResource SecondaryButton}" Margin="4,0,0,0"/>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="ReserveButton" Content="Next CP for selected drawing" Click="ReserveCp_Click"
                            IsEnabled="False" Style="{StaticResource PrimaryButton}"/>
                    <Button x:Name="CompareButton" Content="Compare with previous CP" Click="Compare_Click"
                            IsEnabled="False" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                    <Button x:Name="BluebeamButton" Content="Open both in Bluebeam" Click="OpenInBluebeam_Click"
                            IsEnabled="False" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                    <TextBlock Text="Show" VerticalAlignment="Center" Margin="24,0,8,0"/>
                    <ComboBox x:Name="FilterBox" Width="220" VerticalContentAlignment="Center" SelectedIndex="0"
                              SelectionChanged="FilterBox_SelectionChanged">
                        <ComboBoxItem Content="All check prints"/>
                        <ComboBoxItem Content="Needs checking (FC)"/>
                        <ComboBoxItem Content="Needs technician (COMMENTS)"/>
                        <ComboBoxItem Content="Needs review (UNKNOWN / CONFLICT)"/>
                        <ComboBoxItem Content="Checked (AWC / APPD)"/>
                    </ComboBox>
                    <TextBlock x:Name="ReserveHint" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Select a row for the next CP number. Double-click to open the PDF. Rescans automatically when the folder changes."/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="CheckGrid" Grid.Row="1" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                  SelectionChanged="CheckGrid_SelectionChanged" MouseDoubleClick="CheckGrid_MouseDoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CheckPrint.IsFlagged}" Value="True">
                            <Setter Property="Background" Value="#FFF4E5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Document Code" Binding="{Binding CheckPrint.DocumentCode}" Width="240"/>
                <DataGridTextColumn Header="Revision" Binding="{Binding CheckPrint.Revision}" Width="70"/>
                <DataGridTextColumn Header="CP" Binding="{Binding CheckPrint.Cp}" Width="50"/>
                <DataGridTemplateColumn Header="Check Status" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CheckPrint.Status}" Value="{x:Static models:CheckStatus.FC}">
                                                <Setter Property="Background" Value="#FFF3B6B6"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CheckPrint.Status}" Value="{x:Static models:CheckStatus.AWC}">
                                                <Setter Property="Background" Value="#FFD4F0D6"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CheckPrint.Status}" Value="{x:Static models:CheckStatus.APPD}">
                                                <Setter Property="Background" Value="#FF7FD48A"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CheckPrint.Status}" Value="{x:Static models:CheckStatus.COMMENTS}">
                                                <Setter Property="Background" Value="#FFBBD9F7"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CheckPrint.Status}" Value="{x:Static models:CheckStatus.UNKNOWN}">
                                                <Setter Property="Background" Value="#FFFFC56D"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CheckPrint.Status}" Value="{x:Static models:CheckStatus.CONFLICT}">
                                                <Setter Property="Background" Value="#FFFFA8A8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding CheckPrint.StatusText}" FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn Header="Back-drafted" Binding="{Binding CheckPrint.BackDrafted}" Width="95"/>
                <DataGridTextColumn Header="Markup author*" Binding="{Binding CheckPrint.StampAuthor}" Width="120"/>
                <DataGridTextColumn Header="Markup date*" Binding="{Binding CheckPrint.StampDateText}" Width="145"/>
                <DataGridCheckBoxColumn Header="Current" Binding="{Binding IsCurrent}" Width="65"/>
                <DataGridTextColumn Header="Distribution" Binding="{Binding DistributionText}" Width="105"/>
                <DataGridTextColumn Header="Issue date" Binding="{Binding IssueDate, StringFormat={}{0:yyyy-MM-dd}}" Width="90"/>
                <DataGridTextColumn Header="Issued by" Binding="{Binding RegisterRevision.IssuedBy}" Width="80"/>
                <DataGridTextColumn Header="Purpose" Binding="{Binding RegisterRevision.Purpose}" Width="110"/>
                <DataGridTextColumn Header="Method" Binding="{Binding RegisterRevision.Method}" Width="90"/>
                <DataGridTextColumn Header="Queue reason" Binding="{Binding QueueReason}" Width="220"/>
                <DataGridTextColumn Header="Scan flag" Binding="{Binding CheckPrint.Issue}" Width="180"/>
                <DataGridTextColumn Header="File" Binding="{Binding CheckPrint.FilePath}" Width="240"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="2,8,0,0">
            <TextBlock x:Name="ScanStatus" Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock Text="* Author and date are self-asserted PDF markup metadata."
                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</Window>
