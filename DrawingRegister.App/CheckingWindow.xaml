<Window x:Class="DrawingRegister.App.CheckingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DrawingRegister.App.Models"
        Title="Check Prints" Height="560" Width="1400"
        MinHeight="400" MinWidth="1000"
        Background="{StaticResource Slate50Brush}"
        Icon="pack://application:,,,/DrawingRegister.App;component/Assets/icon.ico">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Checking folder" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="FolderPathBox" Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center"/>
                <Button Grid.Column="2" Content="Select Folder" Click="SelectFolder_Click"
                        Style="{StaticResource SecondaryButton}" Margin="8,0,4,0"/>
                <Button x:Name="ScanButton" Grid.Column="3" Content="Scan" Click="Scan_Click"
                        Style="{StaticResource PrimaryButton}" Margin="4,0,0,0"/>
            </Grid>
        </Border>

        <DataGrid Grid.Row="1" ItemsSource="{Binding CheckPrints}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                            <Setter Property="Background" Value="#FFF4E5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Document Code" Binding="{Binding DocumentCode}" Width="240"/>
                <DataGridTextColumn Header="Revision" Binding="{Binding Revision}" Width="70"/>
                <DataGridTextColumn Header="CP" Binding="{Binding Cp}" Width="50"/>
                <DataGridTemplateColumn Header="Check Status" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:CheckStatus.AWC}">
                                                <Setter Property="Background" Value="#FFFFE08A"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:CheckStatus.APPD}">
                                                <Setter Property="Background" Value="#FFCDECCF"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:CheckStatus.UNKNOWN}">
                                                <Setter Property="Background" Value="#FFFFC56D"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:CheckStatus.CONFLICT}">
                                                <Setter Property="Background" Value="#FFFFA8A8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn Header="Back-drafted" Binding="{Binding BackDrafted}" Width="95"/>
                <DataGridTextColumn Header="Markup author*" Binding="{Binding StampAuthor}" Width="120"/>
                <DataGridTextColumn Header="Markup date*" Binding="{Binding StampDateText}" Width="145"/>
                <DataGridTextColumn Header="Flag" Binding="{Binding Issue}" Width="2*"/>
                <DataGridTextColumn Header="File" Binding="{Binding FilePath}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="2,8,0,0">
            <TextBlock x:Name="ScanStatus" Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock Text="* Author and date are self-asserted PDF markup metadata."
                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</Window>
