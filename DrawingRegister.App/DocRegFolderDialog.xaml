<Window x:Class="DrawingRegister.App.DocRegFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DocReg folder"
        Height="720" Width="1180"
        MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterOwner"
        Background="White" WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">
    <Border BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="10" Background="White"
            Effect="{StaticResource ElevatedShadow}" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="20,14,14,10" MouseLeftButtonDown="Header_DragMove">
                <StackPanel>
                    <TextBlock Text="DocReg folder" Style="{StaticResource HeadingMedium}"/>
                    <TextBlock Text="Review parsed filenames, then export one SER DocReg. Source PDFs are not renamed."
                               Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="CancelButton_Click" Style="{StaticResource ToolbarButton}" FontSize="14" Width="28" Height="28" Padding="0"/>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource BrandRedBrush}" Height="3"/>

            <StackPanel Grid.Row="2" Margin="16,12,16,8">
                <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,0,0,10"
                           Text="Scan this folder and its dated issue folders. Review the filename details before export. Select a row to see its original filename and parsing notes. Edits apply to this export only."/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Folder" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                    <TextBox x:Name="FolderPathBox" Grid.Column="1" Height="28" IsReadOnly="True" Margin="0,0,8,0"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" x:Name="BrowseButton" Content="Browse..." Width="100" Height="28" Margin="0,0,8,0"
                            Click="BrowseFolder_Click" Style="{StaticResource ToolbarButton}"/>
                    <Button Grid.Column="3" x:Name="ScanButton" Content="Scan" Width="90" Height="28"
                            Click="ScanFolder_Click" Style="{StaticResource PrimaryButton}"/>
                </Grid>

                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                        <TextBlock Text="Project no" Style="{StaticResource SectionLabel}" Width="80"/>
                        <TextBox x:Name="ProjectNumberBox" Width="140" Height="28" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                        <TextBlock Text="Project name" Style="{StaticResource SectionLabel}" Width="90"/>
                        <TextBox x:Name="ProjectNameBox" Width="260" Height="28" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                        <TextBlock Text="Discipline" Style="{StaticResource SectionLabel}" Width="80"/>
                        <TextBox x:Name="DisciplineBox" Width="160" Height="28" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </WrapPanel>

                <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="3" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1"
                    CornerRadius="6" Margin="16,0,16,8" ClipToBounds="True">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Background="{StaticResource Slate50Brush}" Margin="0,6,0,0">
                        <TextBlock Text="{Binding SelectedItem.FileName, ElementName=ReviewGrid}" TextWrapping="Wrap" Margin="8,4"/>
                        <TextBlock Text="{Binding SelectedItem.ParseNote, ElementName=ReviewGrid}" TextWrapping="Wrap" Margin="8,0,8,6"/>
                    </StackPanel>
                <DataGrid x:Name="ReviewGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AlternationCount="2"
                          BorderThickness="0"
                          RowHeaderWidth="0"
                          SelectionUnit="FullRow"
                          EnableRowVirtualization="True"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="INCLUDE" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        <DataGridComboBoxColumn x:Name="SectionColumn" Header="GROUP"
                                                SelectedValueBinding="{Binding Section, UpdateSourceTrigger=PropertyChanged}"
                                                SelectedValuePath="Key" DisplayMemberPath="Value"
                                                Width="140">
                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="IsSynchronizedWithCurrentItem" Value="False"/>
                                </Style>
                            </DataGridComboBoxColumn.ElementStyle>
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="IsSynchronizedWithCurrentItem" Value="False"/>
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                        </DataGridComboBoxColumn>
                        <DataGridTextColumn Header="DOCUMENT NO" Binding="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                        <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                        <DataGridTextColumn Header="REV" Binding="{Binding Revision, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        <DataGridTextColumn Header="PACKAGE" Binding="{Binding Package, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        <DataGridTextColumn Header="TYPE" Binding="{Binding DocumentType, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        <DataGridTextColumn Header="SIZE" Binding="{Binding Size, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        <DataGridTemplateColumn Header="ISSUE DATE" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IssueDate, StringFormat=dd/MM/yyyy}" VerticalAlignment="Center" Margin="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding IssueDate, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="PARSED PROJECT" Binding="{Binding ParsedProjectNumber}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="ORIGINAL FILE" Binding="{Binding FileName}" Width="220" IsReadOnly="True"/>
                        <DataGridTextColumn Header="NOTE" Binding="{Binding ParseNote}" Width="280" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Row="4" Background="{StaticResource Slate50Brush}" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,1,0,0" Padding="20,12,20,14">
                <DockPanel>
                    <TextBlock x:Name="CountText" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                               DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Width="110" Height="36" Margin="0,0,8,0"
                                Click="CancelButton_Click" Style="{StaticResource GhostButton}"/>
                        <Button x:Name="ExportButton" Content="Export DocReg" Width="150" Height="36"
                                Click="ExportButton_Click" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
