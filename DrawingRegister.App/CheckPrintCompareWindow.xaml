<Window x:Class="DrawingRegister.App.CheckPrintCompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Compare Check Prints" Height="900" Width="1600" WindowState="Maximized"
        Background="{StaticResource Slate50Brush}"
        Icon="pack://application:,,,/DrawingRegister.App;component/Assets/icon.ico">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="LeftTitle" Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <DockPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Open in Bluebeam" Click="OpenInBluebeam_Click"
                    Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
            <TextBlock x:Name="RightTitle" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <wv2:WebView2 x:Name="LeftView" Grid.Row="1" Grid.Column="0"/>
        <GridSplitter Grid.Row="1" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
        <wv2:WebView2 x:Name="RightView" Grid.Row="1" Grid.Column="2"/>
    </Grid>
</Window>
